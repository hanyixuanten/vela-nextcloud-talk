{
  "name": "vela-nextcloud-talk",
  "version": "0.2.5",
  "private": true,
  "description": "Nextcloud Talk client for Xiaomi Vela smartwatches (Vela JS app)",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "npm run build:circle --",
    "build:circle": "node scripts/build-watch.cjs build circle",
    "build:rect": "node scripts/build-watch.cjs build rect",
    "release": "npm run release:circle --",
    "release:circle": "node scripts/build-watch.cjs release circle",
    "release:rect": "node scripts/build-watch.cjs release rect",
    "icon": "python3 scripts/gen-icon.py",
    "test": "sh tests/run.sh && node tests/build-watch.test.cjs",
    "sync:ime": "sh scripts/sync-input-method.sh"
  },
  "devDependencies": {
    "@aiot-toolkit/jsc": "^1.0.3",
    "aiot-toolkit": "^2.0.5"
  }
}
