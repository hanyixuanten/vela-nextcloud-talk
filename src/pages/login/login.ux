<import name="app-pill" src="../../components/ui/AppPill.ux"></import>
<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/pink.png"></image>

    <!-- The input method is position:absolute at the bottom, so it never takes
         part in layout. Each state therefore reserves its space explicitly and
         fills exactly 100% of the page, which is what keeps the page from
         becoming scrollable. -->
    <div class="layout" if="{{!editing}}">
      <div class="top">
        <text class="t-display brand">{{ $t('app.name') }}</text>
        <!-- The two ways into the app. This replaced the "Nextcloud Talk"
             tagline: the mode is the first thing the form depends on, and the
             tagline only repeated the app name. `if` moves the fields, so the
             two forms never share a slot. -->
        <div class="modes">
          <div class="mode {{ mode === 'account' ? 'mode-on' : '' }}" @click="switchMode('account')">
            <text class="mode-text {{ mode === 'account' ? 'mode-text-on' : '' }}">{{ $t('login.modeAccount') }}</text>
          </div>
          <div class="mode {{ mode === 'public' ? 'mode-on' : '' }}" @click="switchMode('public')">
            <text class="mode-text {{ mode === 'public' ? 'mode-text-on' : '' }}">{{ $t('login.modePublic') }}</text>
          </div>
        </div>
      </div>

      <div class="form">
        <!-- Account: server, user, app password. -->
        <div class="field" if="{{mode === 'account'}}" @click="startEdit(0)">
          <text class="t-label field-label">{{ $t('login.server') }}</text>
          <text class="field-value {{ server ? '' : 'field-empty' }}">{{ server || $t('login.serverHint') }}</text>
        </div>
        <div class="field" if="{{mode === 'account'}}" @click="startEdit(1)">
          <text class="t-label field-label">{{ $t('login.user') }}</text>
          <text class="field-value {{ user ? '' : 'field-empty' }}">{{ user || $t('login.userHint') }}</text>
        </div>
        <div class="field" if="{{mode === 'account'}}" @click="startEdit(2)">
          <text class="t-label field-label">{{ $t('login.password') }}</text>
          <text class="field-value {{ appPassword ? '' : 'field-empty' }}">{{ appPassword ? maskedPassword : $t('login.passwordHint') }}</text>
        </div>

        <!-- Public conversation: the share link, an optional password, and the
             name the other participants see. The link carries the server, so
             there is no separate server field and the form stays three rows on
             the round screen. -->
        <div class="field" if="{{mode === 'public'}}" @click="startEdit(0)">
          <text class="t-label field-label">{{ $t('login.roomLink') }}</text>
          <text class="field-value {{ roomLink ? '' : 'field-empty' }}">{{ roomLink || $t('login.roomLinkHint') }}</text>
        </div>
        <div class="field" if="{{mode === 'public'}}" @click="startEdit(1)">
          <text class="t-label field-label">{{ $t('login.roomPassword') }}</text>
          <text class="field-value {{ roomPassword ? '' : 'field-empty' }}">{{ roomPassword ? maskedRoomPassword : $t('login.roomPasswordHint') }}</text>
        </div>
        <div class="field" if="{{mode === 'public'}}" @click="startEdit(2)">
          <text class="t-label field-label">{{ $t('login.roomName') }}</text>
          <text class="field-value {{ roomName ? '' : 'field-empty' }}">{{ roomName || $t('login.roomNameHint') }}</text>
        </div>

        <div class="connect">
          <!-- One label, computed in syncSubmitLabel(): a nested ternary
               here would be the only one of its kind in the app, and this
               string is the page's single call to action. -->
          <app-pill text="{{ submitLabel }}"
                    width="100%" primary="{{true}}" busy="{{submitting}}" @click="submit"></app-pill>
        </div>

        <text class="t-error error" show="{{error}}">{{ error }}</text>

        <!-- The setup page is the only place that listens on interconnect, so a
             user who lands here must still be able to reach it. -->
        <text class="link" @click="openSetup">{{ $t('login.fromPhone') }}</text>
      </div>
    </div>

    <!-- Editing state: only the draft stays on screen. The actions sit right
         above the keyboard thanks to `keyboard-gap`, which mirrors the height
         of the absolutely positioned input method. -->
    <!-- No dismiss key on the keyboard: tapping the label/value area closes it. -->
    <div class="edit-panel" if="{{editing}}">
      <div class="edit-top" @click="stopEdit">
        <text class="t-label" if="{{activeIndex === 0}}">{{ mode === 'public' ? $t('login.roomLink') : $t('login.server') }}</text>
        <text class="t-label" if="{{activeIndex === 1}}">{{ mode === 'public' ? $t('login.roomPassword') : $t('login.user') }}</text>
        <text class="t-label" if="{{activeIndex === 2}}">{{ mode === 'public' ? $t('login.roomName') : $t('login.password') }}</text>

        <text class="edit-value" if="{{activeIndex === 0}}">{{ mode === 'public' ? (roomLink || $t('login.roomLinkHint')) : (server || $t('login.serverHint')) }}_</text>
        <text class="edit-value" if="{{activeIndex === 1}}">{{ mode === 'public' ? maskedRoomPassword : (user || $t('login.userHint')) }}_</text>
        <text class="edit-value" if="{{activeIndex === 2}}">{{ mode === 'public' ? (roomName || $t('login.roomNameHint')) : maskedPassword }}_</text>
      </div>

      <div class="edit-actions">
        <div class="ghost" @click="nextField">
          <text class="pill-small-text">{{ $t('login.next') }}</text>
        </div>
        <div class="ghost" @click="stopEdit">
          <text class="pill-small-text">{{ $t('login.done') }}</text>
        </div>
      </div>

      <div class="keyboard-gap"></div>
    </div>

    <input-method
      hide="{{!editing}}"
      keyboardtype="{{keyboardType}}"
      <!-- if true: process.env.SHAPE === 'CIRCLE' -->
      screentype="circle"
      <!-- endif -->
      <!-- if true: process.env.SHAPE === 'RECT' -->
      screentype="rect"
      <!-- endif -->
      maxlength="5"
      vibratemode="short"
      @complete="onKeyComplete"
      @delete="onKeyDelete"
    ></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import api from '../../common/scripts/api'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import { ROUTE } from '../../common/scripts/launch'
import { sharedOf } from '../../common/scripts/shared'
import { parseRoomLink, buildRoomLink } from '../../common/scripts/roomlink'

function trimLastChar(text) {
  const source = String(text || '')
  if (source.length === 0) return ''
  const last = source.charCodeAt(source.length - 1)
  // Keep surrogate pairs (emoji) intact instead of leaving half a character.
  if (last >= 0xdc00 && last <= 0xdfff && source.length >= 2) {
    return source.slice(0, source.length - 2)
  }
  return source.slice(0, source.length - 1)
}

function withoutSlash(value) {
  return String(value || '').trim().replace(/\/+$/, '')
}

export default {
  data: {
    mode: 'account',

    // Account mode.
    server: '',
    user: '',
    appPassword: '',
    maskedPassword: '',

    // Public mode.
    roomLink: '',
    roomPassword: '',
    maskedRoomPassword: '',
    roomName: '',

    editing: false,
    activeIndex: -1,
    submitting: false,
    submitLabel: '',
    error: '',
    keyboardType: 'QWERTY'
  },

  onInit() {
    // A settings row can send the user straight to the tab it wants to edit.
    const shared = sharedOf(this, state)
    const pending = shared && shared.pendingMode
    if (shared && shared.pendingMode) shared.pendingMode = null

    this.settingsReady = store.load().then((settings) => {
      // The submit handlers merge into what is stored, so the page has to know
      // it even when it opened straight onto the form (no splash in between).
      state.settings = settings
      this.mode = pending === 'public' || (!pending && settings.mode === 'public') ? 'public' : 'account'
      this.server = settings.baseUrl || 'https://'
      this.user = settings.user || ''
      this.appPassword = settings.appPassword || ''
      this.roomLink = buildRoomLink(settings.baseUrl, settings.roomToken)
      this.roomPassword = settings.roomPassword || ''
      this.roomName = settings.roomDisplayName || ''
      this.syncMasked()
      this.syncSubmitLabel()
      this.keyboardType = settings.keyboardType || 'QWERTY'
      return settings
    })
  },

  syncMasked() {
    this.maskedPassword = this.maskFor(this.appPassword)
    this.maskedRoomPassword = this.maskFor(this.roomPassword)
  },

  maskFor(value) {
    let dots = ''
    for (let i = 0; i < String(value || '').length; i += 1) dots += '•'
    return dots
  },

  switchMode(target) {
    const next = target === 'public' ? 'public' : 'account'
    if (this.mode === next) return
    this.mode = next
    this.editing = false
    this.activeIndex = -1
    this.error = ''
    this.syncSubmitLabel()
  },

  /**
   * Navigation on this firmware can be dropped silently (nav.js retries and
   * then only toasts), so a successful submit must not leave the button stuck
   * in 'connecting…': that would be a page with no working action left.
   */
  releaseSubmit() {
    this.submitting = false
    this.syncSubmitLabel()
  },

  /**
   * The button says what the tap will do in the current mode, and while it is
   * running says what it is doing. Kept as data rather than written into the
   * template so there is one place to read, and one place to test.
   */
  syncSubmitLabel() {
    if (this.submitting) {
      this.submitLabel = this.mode === 'public' ? this.$t('login.joining') : this.$t('login.connecting')
      return
    }
    this.submitLabel = this.mode === 'public' ? this.$t('login.join') : this.$t('login.connect')
  },

  startEdit(index) {
    this.activeIndex = index
    this.editing = true
    this.error = ''
  },

  stopEdit() {
    this.editing = false
    this.activeIndex = -1
  },

  nextField() {
    if (this.activeIndex < 2) {
      this.activeIndex = this.activeIndex + 1
      return
    }
    this.stopEdit()
  },

  applyText(value) {
    if (this.mode === 'public') {
      if (this.activeIndex === 0) this.roomLink += value
      else if (this.activeIndex === 1) {
        this.roomPassword += value
        this.syncMasked()
      } else if (this.activeIndex === 2) this.roomName += value
      return
    }
    if (this.activeIndex === 0) this.server += value
    else if (this.activeIndex === 1) this.user += value
    else if (this.activeIndex === 2) {
      this.appPassword += value
      this.syncMasked()
    }
  },

  removeText() {
    if (this.mode === 'public') {
      if (this.activeIndex === 0) this.roomLink = trimLastChar(this.roomLink)
      else if (this.activeIndex === 1) {
        this.roomPassword = trimLastChar(this.roomPassword)
        this.syncMasked()
      } else if (this.activeIndex === 2) this.roomName = trimLastChar(this.roomName)
      return
    }
    if (this.activeIndex === 0) this.server = trimLastChar(this.server)
    else if (this.activeIndex === 1) this.user = trimLastChar(this.user)
    else if (this.activeIndex === 2) {
      this.appPassword = trimLastChar(this.appPassword)
      this.syncMasked()
    }
  },

  onKeyComplete(evt) {
    const content = evt && evt.detail ? evt.detail.content : ''
    if (!content) return
    this.applyText(content)
  },

  onKeyDelete() {
    this.removeText()
  },

  openSetup() {
    router.replace({ uri: ROUTE.setup })
  },

  /** Why a pasted link could not be split, in words a wrist can act on. */
  describeLinkError(error) {
    if (error === 'scheme') return this.$t('login.errScheme')
    if (error === 'base') return this.$t('login.errRoomBase')
    if (error === 'token') return this.$t('login.errRoomToken')
    if (error === 'host') return this.$t('login.errRoomHost')
    return this.$t('login.errRoomLink')
  },

  submit() {
    if (this.submitting) return
    if (this.mode === 'public') {
      this.submitPublic()
      return
    }
    this.submitAccount()
  },

  /**
   * Account mode. Persist before validating: the app password was typed on a
   * watch keyboard and a failed round trip must not discard it. Validation only
   * adds the display name, and a rejection leaves the user on this page with
   * what they typed already stored, ready to be corrected.
   */
  submitAccount() {
    const baseUrl = withoutSlash(this.server)
    const user = String(this.user || '').trim()
    const appPassword = String(this.appPassword || '').trim()

    if (!baseUrl || !user || !appPassword) {
      this.error = this.$t('login.errRequired')
      return
    }
    if (!/^https:\/\//i.test(baseUrl)) {
      this.error = this.$t('login.errScheme')
      return
    }

    this.editing = false
    this.activeIndex = -1
    this.submitting = true
    this.syncSubmitLabel()
    this.error = ''

    const previous = state.settings || store.DEFAULT_SETTINGS
    const candidate = Object.assign({}, previous, {
      mode: 'account',
      baseUrl: baseUrl,
      user: user,
      appPassword: appPassword
    })
    // A stored display name belongs to the account it was fetched for.
    const previousBase = withoutSlash(previous.baseUrl)
    if (previousBase !== baseUrl || previous.user !== user) {
      candidate.displayName = ''
    }

    let persisted = false
    store.save(candidate)
      .then((saved) => {
        persisted = true
        state.settings = saved
        state.ready = true
        api.configure(saved)
        return api.getCurrentUser(saved)
          .then((profile) => store.save(Object.assign({}, saved, { displayName: profile.displayName }))
            // The name is cosmetic; a failed write must not fail a good login.
            .catch(() => saved))
          .then((named) => {
            state.settings = named
            api.configure(named)
            prompt.showToast({ message: this.$t('login.saved'), duration: 1500 })
            this.releaseSubmit()
            router.replace({ uri: ROUTE.home })
          })
      })
      .catch((err) => {
        this.submitting = false
        this.syncSubmitLabel()
        const reason = err && err.message ? err.message : this.$t('login.errRequired')
        // Keep the client on what is actually on disk, so a retry only has to
        // correct the wrong field.
        api.configure(state.settings || {})
        this.error = persisted
          ? this.$t('login.savedUnverified', { message: reason })
          : reason
      })
  },

  /**
   * Public mode. Same order as the account form — write, then join — for the
   * same reason: the link and the name were typed on the watch, and the join is
   * a network round trip that can fail for reasons that say nothing about the
   * input. A rejection still leaves a configured room on disk, and the join's
   * own error (wrong password / not a public room) is what the user sees.
   */
  submitPublic() {
    // A bare token is only usable when a server is already known (the account
    // tab or a previous configuration put one in this same field).
    const server = withoutSlash(this.server)
    const parsed = parseRoomLink(this.roomLink, /^https:\/\//i.test(server) ? server : '')
    if (!parsed.ok) {
      this.error = this.describeLinkError(parsed.error)
      return
    }
    if (!/^https:\/\//i.test(parsed.baseUrl)) {
      this.error = this.$t('login.errScheme')
      return
    }
    const roomName = String(this.roomName || '').trim()
    if (!roomName) {
      this.error = this.$t('login.errRoomName')
      return
    }
    // A link pasted from Talk may carry `?password=`; the field always wins
    // when it has something in it.
    const roomPassword = String(this.roomPassword || '').trim() || parsed.password || ''

    this.editing = false
    this.activeIndex = -1
    this.submitting = true
    this.syncSubmitLabel()
    this.error = ''

    const previous = state.settings || store.DEFAULT_SETTINGS
    const candidate = Object.assign({}, previous, {
      mode: 'public',
      baseUrl: parsed.baseUrl,
      roomToken: parsed.token,
      roomPassword: roomPassword,
      roomDisplayName: roomName
    })
    // The guest session (cookies + actor id) and the cached title belong to one
    // conversation; carrying them to another would replay a dead session.
    const sameRoom = withoutSlash(previous.baseUrl) === parsed.baseUrl &&
      String(previous.roomToken || '').toLowerCase() === parsed.token
    if (!sameRoom) {
      candidate.roomName = ''
      candidate.roomActorId = ''
      candidate.sessionCookies = ''
    }

    let persisted = false
    store.save(candidate)
      .then((saved) => {
        persisted = true
        state.settings = saved
        state.ready = true
        api.configure(saved)
        return api.joinPublicRoom()
          .then((room) => {
            // api.js already wrote the session record; keep this page's copy in
            // step so the page we navigate to starts from the same guest.
            const session = api.getSession ? api.getSession() : {}
            const named = Object.assign({}, saved, {
              roomName: room.name || saved.roomName || saved.roomToken,
              roomActorId: session.actorId || saved.roomActorId,
              sessionCookies: session.cookies || saved.sessionCookies
            })
            return store.save(named).catch(() => named)
          })
          .then((named) => {
            state.settings = named
            api.configure(named)
            prompt.showToast({ message: this.$t('login.publicJoined'), duration: 1500 })
            this.releaseSubmit()
            router.replace({ uri: ROUTE.home })
          })
      })
      .catch((err) => {
        this.submitting = false
        this.syncSubmitLabel()
        const reason = err && err.message ? err.message : this.$t('login.errRoomLink')
        // Fall back to what is on disk: a rejected join must not leave the API
        // client pointed at a half-written candidate.
        api.configure(state.settings || {})
        this.error = persisted
          ? this.$t('login.savedUnverified', { message: reason })
          : reason
      })
  }
}
</script>

<style>
@import "../../common/styles/theme.css";

/* Both state containers fill the page and are laid out as columns; the flexible
 * child absorbs whatever the fixed children leave, so the sum is always exactly
 * 100% and the page can never scroll. */
.layout, .edit-panel {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
}

/* Tall enough for the brand plus the two mode tabs (44 + 6 + 30). The tagline
 * that used to live here was replaced by them, so the height grew by one row
 * and the form below it stays inside the round screen. */
.top {
  height: 108px;
  padding-top: 12px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.brand {
  font-size: 44px;
}

/* Account / public switch. Two tabs, one of them filled with the accent: the
 * same "selected" language as the rest of the UI, no extra chrome. */
.modes {
  width: 74%;
  height: 30px;
  margin-top: 6px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.mode {
  width: 48%;
  height: 30px;
  border-radius: 15px;
  background-color: #1f1f1f;
  justify-content: center;
  align-items: center;
}

.mode-on {
  background-color: #ff7da8;
}

.mode-text {
  font-size: 17px;
  font-weight: 600;
  color: #9c9c9c;
}

.mode-text-on {
  color: #1a1a1a;
}

.form {
  flex: 1;
  width: 78%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Card fields: label above value, like the template's setting rows. Margins
 * instead of padding, because Vela's box model makes padded fixed-width boxes
 * overflow in one of the two shapes. */
.field {
  width: 100%;
  height: 60px;
  margin-top: 8px;
  border-radius: 24px;
  background-color: #262626;
  flex-direction: column;
  justify-content: center;
}

.field-label {
  margin-left: 20px;
  font-size: 17px;
}

.field-value {
  width: 84%;
  margin-left: 20px;
  margin-top: 1px;
  font-size: 21px;
  font-weight: 500;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.field-empty {
  color: #6a6a6a;
}

.connect {
  width: 100%;
  margin-top: 14px;
}

/* Reserved two-line strip: an error must not be what pushes the link off. */
.error {
  width: 94%;
  height: 44px;
  margin-top: 6px;
  font-size: 18px;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}

.link {
  width: 92%;
  height: 26px;
  margin-top: 4px;
  font-size: 19px;
  font-weight: 500;
  color: #ff7da8;
  text-align: center;
}

.edit-top {
  flex: 1;
  width: 78%;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.edit-value {
  width: 100%;
  margin-top: 6px;
  font-size: 26px;
  font-weight: 600;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.edit-actions {
  width: 78%;
  height: 56px;
  margin-top: 8px;
  margin-bottom: 6px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.ghost {
  width: 46%;
  height: 56px;
  border-radius: 28px;
  background-color: #262626;
  justify-content: center;
  align-items: center;
}

/* Mirrors @components/InputMethod: 480x321 on the round screen. */
.keyboard-gap {
  width: 100%;
  height: 321px;
}

/* if true: process.env.SHAPE === 'CIRCLE' */
.top {
  height: 108px;
  padding-top: 26px;
}
.form, .edit-top, .edit-actions {
  width: 74%;
}
.modes {
  width: 74%;
}
.edit-actions {
  margin-bottom: 2px;
}
/* endif */

/* if true: process.env.SHAPE === 'RECT' */
/* Rect keyboard is 255px tall plus a 28px candidate row. */
.app-bg {
  width: 480px;
  height: 640px;
}
.top {
  height: 92px;
  padding-top: 8px;
}
.form, .edit-top, .edit-actions {
  width: 86%;
}
.modes {
  width: 86%;
}
.field {
  height: 72px;
}
.keyboard-gap {
  height: 283px;
}
/* endif */
</style>
