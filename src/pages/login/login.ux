<import name="app-pill" src="../../components/ui/AppPill.ux"></import>
<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/pink.png"></image>

    <!-- The input method is position:absolute at the bottom, so it never takes
         part in layout. Each state therefore reserves its space explicitly and
         fills exactly 100% of the page, which is what keeps the page from
         becoming scrollable. -->
    <div class="layout" if="{{!editing}}">
      <div class="top">
        <text class="t-display brand">{{ $t('app.name') }}</text>
        <text class="t-caption tagline">{{ $t('login.subtitle') }}</text>
      </div>

      <div class="form">
        <div class="field" @click="startEdit(0)">
          <text class="t-label field-label">{{ $t('login.server') }}</text>
          <text class="field-value {{ server ? '' : 'field-empty' }}">{{ server || $t('login.serverHint') }}</text>
        </div>
        <div class="field" @click="startEdit(1)">
          <text class="t-label field-label">{{ $t('login.user') }}</text>
          <text class="field-value {{ user ? '' : 'field-empty' }}">{{ user || $t('login.userHint') }}</text>
        </div>
        <div class="field" @click="startEdit(2)">
          <text class="t-label field-label">{{ $t('login.password') }}</text>
          <text class="field-value {{ appPassword ? '' : 'field-empty' }}">{{ appPassword ? maskedPassword : $t('login.passwordHint') }}</text>
        </div>

        <div class="connect">
          <app-pill text="{{ submitting ? $t('login.connecting') : $t('login.connect') }}"
                    width="100%" primary="true" busy="{{submitting}}" @click="submit"></app-pill>
        </div>

        <text class="t-error error" show="{{error}}">{{ error }}</text>

        <!-- The setup page is the only place that listens on interconnect, so a
             user who lands here must still be able to reach it. -->
        <text class="link" @click="openSetup">{{ $t('login.fromPhone') }}</text>
      </div>
    </div>

    <!-- Editing state: only the draft stays on screen. The actions sit right
         above the keyboard thanks to `keyboard-gap`, which mirrors the height
         of the absolutely positioned input method. -->
    <!-- No dismiss key on the keyboard: tapping the label/value area closes it. -->
    <div class="edit-panel" if="{{editing}}">
      <div class="edit-top" @click="stopEdit">
        <text class="t-label" if="{{activeIndex === 0}}">{{ $t('login.server') }}</text>
        <text class="t-label" if="{{activeIndex === 1}}">{{ $t('login.user') }}</text>
        <text class="t-label" if="{{activeIndex === 2}}">{{ $t('login.password') }}</text>
        <text class="edit-value" if="{{activeIndex === 0}}">{{ server || $t('login.serverHint') }}_</text>
        <text class="edit-value" if="{{activeIndex === 1}}">{{ user || $t('login.userHint') }}_</text>
        <text class="edit-value" if="{{activeIndex === 2}}">{{ maskedPassword }}_</text>
      </div>

      <div class="edit-actions">
        <div class="ghost" @click="nextField">
          <text class="pill-small-text">{{ $t('login.next') }}</text>
        </div>
        <div class="ghost" @click="stopEdit">
          <text class="pill-small-text">{{ $t('login.done') }}</text>
        </div>
      </div>

      <div class="keyboard-gap"></div>
    </div>

    <input-method
      hide="{{!editing}}"
      keyboardtype="{{keyboardType}}"
      <!-- if true: process.env.SHAPE === 'CIRCLE' -->
      screentype="circle"
      <!-- endif -->
      <!-- if true: process.env.SHAPE === 'RECT' -->
      screentype="rect"
      <!-- endif -->
      maxlength="5"
      vibratemode="short"
      @complete="onKeyComplete"
      @delete="onKeyDelete"
    ></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import api from '../../common/scripts/api'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'

function trimLastChar(text) {
  const source = String(text || '')
  if (source.length === 0) return ''
  const last = source.charCodeAt(source.length - 1)
  // Keep surrogate pairs (emoji) intact instead of leaving half a character.
  if (last >= 0xdc00 && last <= 0xdfff && source.length >= 2) {
    return source.slice(0, source.length - 2)
  }
  return source.slice(0, source.length - 1)
}

export default {
  data: {
    server: '',
    user: '',
    appPassword: '',
    maskedPassword: '',
    editing: false,
    activeIndex: -1,
    submitting: false,
    error: '',
    keyboardType: 'QWERTY'
  },

  onInit() {
    store.load().then((settings) => {
      this.server = settings.baseUrl || 'https://'
      this.user = settings.user || ''
      this.appPassword = settings.appPassword || ''
      this.syncMasked()
      this.keyboardType = settings.keyboardType || 'QWERTY'
    })
  },

  syncMasked() {
    let dots = ''
    for (let i = 0; i < this.appPassword.length; i += 1) dots += '•'
    this.maskedPassword = dots
  },

  startEdit(index) {
    this.activeIndex = index
    this.editing = true
    this.error = ''
  },

  stopEdit() {
    this.editing = false
    this.activeIndex = -1
  },

  nextField() {
    if (this.activeIndex < 2) {
      this.activeIndex = this.activeIndex + 1
      return
    }
    this.stopEdit()
  },

  applyText(value) {
    if (this.activeIndex === 0) this.server += value
    else if (this.activeIndex === 1) this.user += value
    else if (this.activeIndex === 2) {
      this.appPassword += value
      this.syncMasked()
    }
  },

  removeText() {
    if (this.activeIndex === 0) this.server = trimLastChar(this.server)
    else if (this.activeIndex === 1) this.user = trimLastChar(this.user)
    else if (this.activeIndex === 2) {
      this.appPassword = trimLastChar(this.appPassword)
      this.syncMasked()
    }
  },

  onKeyComplete(evt) {
    const content = evt && evt.detail ? evt.detail.content : ''
    if (!content) return
    this.applyText(content)
  },

  onKeyDelete() {
    this.removeText()
  },

  openSetup() {
    router.replace({ uri: '/setup' })
  },

  submit() {
    if (this.submitting) return

    const baseUrl = String(this.server || '').trim().replace(/\/+$/, '')
    const user = String(this.user || '').trim()
    const appPassword = String(this.appPassword || '').trim()

    if (!baseUrl || !user || !appPassword) {
      this.error = this.$t('login.errRequired')
      return
    }
    if (!/^https:\/\//i.test(baseUrl)) {
      this.error = this.$t('login.errScheme')
      return
    }

    this.editing = false
    this.activeIndex = -1
    this.submitting = true
    this.error = ''

    const previous = state.settings || store.DEFAULT_SETTINGS
    const candidate = Object.assign({}, previous, {
      baseUrl: baseUrl,
      user: user,
      appPassword: appPassword
    })
    // A stored display name belongs to the account it was fetched for.
    const previousBase = String(previous.baseUrl || '').replace(/\/+$/, '')
    if (previousBase !== baseUrl || previous.user !== user) {
      candidate.displayName = ''
    }

    // Persist before validating: the app password was typed on a watch
    // keyboard and a failed round trip must not discard it. Validation only
    // adds the display name, and a rejection leaves the user on this page with
    // what they typed already stored, ready to be corrected.
    let persisted = false
    store.save(candidate)
      .then((saved) => {
        persisted = true
        state.settings = saved
        state.ready = true
        api.configure(saved)
        return api.getCurrentUser(saved)
          .then((profile) => store.save(Object.assign({}, saved, { displayName: profile.displayName }))
            // The name is cosmetic; a failed write must not fail a good login.
            .catch(() => saved))
          .then((named) => {
            state.settings = named
            api.configure(named)
            prompt.showToast({ message: this.$t('login.saved'), duration: 1500 })
            router.replace({ uri: '/' })
          })
      })
      .catch((err) => {
        this.submitting = false
        const reason = err && err.message ? err.message : this.$t('login.errRequired')
        // Keep the client on what is actually on disk, so a retry only has to
        // correct the wrong field.
        api.configure(state.settings || {})
        this.error = persisted
          ? this.$t('login.savedUnverified', { message: reason })
          : reason
      })
  }
}
</script>

<style>
@import "../../common/styles/theme.css";

/* Both state containers fill the page and are laid out as columns; the flexible
 * child absorbs whatever the fixed children leave, so the sum is always exactly
 * 100% and the page can never scroll. */
.layout, .edit-panel {
  width: 100%;
  height: 100%;
  flex-direction: column;
  align-items: center;
}

.top {
  height: 96px;
  padding-top: 12px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.brand {
  font-size: 44px;
}

.tagline {
  margin-top: 6px;
}

.form {
  flex: 1;
  width: 78%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Card fields: label above value, like the template's setting rows. Margins
 * instead of padding, because Vela's box model makes padded fixed-width boxes
 * overflow in one of the two shapes. */
.field {
  width: 100%;
  height: 60px;
  margin-top: 8px;
  border-radius: 24px;
  background-color: #262626;
  flex-direction: column;
  justify-content: center;
}

.field-label {
  margin-left: 20px;
  font-size: 17px;
}

.field-value {
  width: 84%;
  margin-left: 20px;
  margin-top: 1px;
  font-size: 21px;
  font-weight: 500;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.field-empty {
  color: #6a6a6a;
}

.connect {
  width: 100%;
  margin-top: 14px;
}

/* Reserved two-line strip: an error must not be what pushes the link off. */
.error {
  width: 94%;
  height: 44px;
  margin-top: 6px;
  font-size: 18px;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}

.link {
  width: 92%;
  height: 26px;
  margin-top: 4px;
  font-size: 19px;
  font-weight: 500;
  color: #ff7da8;
  text-align: center;
}

.edit-top {
  flex: 1;
  width: 78%;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.edit-value {
  width: 100%;
  margin-top: 6px;
  font-size: 26px;
  font-weight: 600;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.edit-actions {
  width: 78%;
  height: 56px;
  margin-top: 8px;
  margin-bottom: 6px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.ghost {
  width: 46%;
  height: 56px;
  border-radius: 28px;
  background-color: #262626;
  justify-content: center;
  align-items: center;
}

/* Mirrors @components/InputMethod: 480x321 on the round screen. */
.keyboard-gap {
  width: 100%;
  height: 321px;
}

/* if true: process.env.SHAPE === 'CIRCLE' */
.top {
  height: 96px;
  padding-top: 26px;
}
.form, .edit-top, .edit-actions {
  width: 74%;
}
.edit-actions {
  margin-bottom: 2px;
}
/* endif */

/* if true: process.env.SHAPE === 'RECT' */
/* Rect keyboard is 255px tall plus a 28px candidate row. */
.top {
  height: 92px;
  padding-top: 8px;
}
.form, .edit-top, .edit-actions {
  width: 86%;
}
.field {
  height: 72px;
}
.keyboard-gap {
  height: 283px;
}
/* endif */
</style>
