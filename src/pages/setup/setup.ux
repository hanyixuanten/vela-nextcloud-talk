<import name="app-pill" src="../../components/ui/AppPill.ux"></import>

<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/pink.png"></image>

    <div class="head">
      <text class="t-title">{{ $t('setup.title') }}</text>
      <text class="status {{ statusClass }}">{{ statusText }}</text>
    </div>

    <div class="info" show="{{serverLabel}}">
      <text class="t-label info-label">{{ $t('setup.server') }}</text>
      <text class="info-value">{{ serverLabel }}</text>
      <text class="t-label info-label">{{ $t('setup.user') }}</text>
      <text class="info-value">{{ userLabel }}</text>
    </div>

    <text class="hint" show="{{!serverLabel}}">{{ $t('setup.hint') }}</text>

    <div class="actions">
      <app-pill text="{{ $t('common.back') }}" width="46%" small="true" @click="goBack"></app-pill>
      <app-pill text="{{ $t('setup.manual') }}" width="46%" small="true" @click="openLogin"></app-pill>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import interconnect from '@system.interconnect'
import api from '../../common/scripts/api'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import { ROUTE } from '../../common/scripts/launch'
import protocol from '../../common/scripts/protocol'
import brightness from '@system.brightness'

export default {
  data: {
    statusText: '',
    statusClass: 'status-waiting',
    serverLabel: '',
    userLabel: ''
  },

  onInit() {
    this.link = null
    this.busy = false
    this.exitTimer = null
    this.setWaiting()
  },

  onShow() {
    if (this.link) return
    this.setWaiting()
    try {
      const connect = interconnect.instance()
      if (!connect || typeof connect.send !== 'function') throw new Error('interconnect unavailable')
      const link = { connect }
      this.link = link
      connect.onopen = () => {
        if (this.link === link && !this.busy && this.exitTimer === null && this.statusClass !== 'status-ok') {
          this.setWaiting()
        }
      }
      connect.onclose = (evt) => this.onLinkError(link, evt)
      connect.onerror = (evt) => this.onLinkError(link, evt)
      connect.onmessage = (evt) => {
        if (this.link === link) this.onMessage(link, evt && evt.data)
      }
    } catch (e) {
      this.detachLink()
      this.setError(this.$t('setup.unsupported'))
    }
  },

  onHide() {
    this.detachLink()
  },

  onDestroy() {
    this.detachLink()
  },

  // Vela exposes this on @system.brightness (not @system.screen). Every call
  // is best effort: a firmware without the API must not break the handoff.
  keepAwake(on) {
    try {
      brightness.setKeepScreenOn({
        keepScreenOn: Boolean(on),
        fail: (data, code) => console.log('setKeepScreenOn failed, code = ' + code)
      })
    } catch (err) {
      console.log('setKeepScreenOn threw: ' + ((err && err.message) || err))
    }
  },

  detachLink() {
    this.keepAwake(false)
    if (this.exitTimer !== null) clearTimeout(this.exitTimer)
    this.exitTimer = null
    const link = this.link
    this.link = null
    if (!link) return
    // interconnect.instance() is shared: do not leave callbacks on a hidden page.
    const connect = link.connect
    connect.onmessage = null
    connect.onopen = null
    connect.onclose = null
    connect.onerror = null
  },

  onLinkError(link, evt) {
    if (this.link !== link || this.busy || this.statusClass === 'status-ok') return
    const code = evt && evt.code ? '（' + evt.code + '）' : ''
    this.setError(this.$t('setup.linkError') + code)
  },

  setWaiting() {
    this.statusText = this.$t('setup.waiting')
    this.statusClass = 'status-waiting'
  },

  setError(message) {
    this.statusText = message
    this.statusClass = 'status-error'
  },

  onMessage(link, raw) {
    const parsed = protocol.parseCredentialMessage(raw)
    if (parsed.silent) return
    const requestId = parsed.requestId
    if (this.busy || this.statusClass === 'status-ok') {
      this.reply(link, { ok: false, requestId, message: this.$t('setup.busy') })
      return
    }
    if (!parsed.ok) {
      this.setError(parsed.error)
      this.reply(link, { ok: false, requestId, message: parsed.error })
      return
    }

    this.busy = true
    // The validation is a network round trip that can take 20 s; the watch
    // would blank the screen half way through it and hide the result.
    this.keepAwake(true)
    this.serverLabel = parsed.config.baseUrl
    this.userLabel = parsed.config.user
    this.statusText = this.$t('setup.verifying')
    this.statusClass = 'status-waiting'

    const previous = state.settings || {}
    const candidate = Object.assign({}, previous, parsed.config)
    // The stored display name belongs to whichever account was configured
    // before it; a different identity must not inherit it if validation fails.
    if (previous.baseUrl !== candidate.baseUrl || previous.user !== candidate.user) {
      candidate.displayName = ''
    }

    // Write first, validate second. The app password was typed once on the
    // phone: a 20 s timeout on the watch network, a rejected password or the
    // user leaving this page must not throw it away. Validation only supplies
    // the display name, so its answer never decides whether input is kept.
    store.save(candidate).then(
      (saved) => {
        state.settings = saved
        state.ready = true
        api.configure(saved)
        // Leaving the page ends the report, not the save that already happened.
        if (this.link !== link) return
        this.verify(link, requestId, saved)
      },
      (err) => {
        // Nothing reached storage, so claiming "saved" here would be a lie.
        this.finish()
        const message = (err && err.message) || this.$t('setup.failed')
        if (this.link !== link) return
        this.setError(message)
        this.reply(link, { ok: false, requestId, message })
      }
    )
  },

  verify(link, requestId, saved) {
    api.getCurrentUser(saved)
      .then((profile) => {
        // Leaving the setup page invalidates the answer, never the save above.
        if (this.link !== link) return null
        return store.save(Object.assign({}, saved, { displayName: profile.displayName }))
          // The display name is cosmetic: a failed write must not turn a
          // working account into a reported failure.
          .catch(() => saved)
      })
      .then((named) => {
        this.finish()
        if (!named) return
        // getCurrentUser answered, so the network demonstrably works. Mark the
        // launch gate as passed: the plugin can open this page directly (no
        // splash), and without this the exit below would bounce through
        // pages/splash and pay for a second probe.
        state.settings = named
        api.configure(named)
        if (this.link !== link) return
        this.statusText = this.$t('setup.done', { name: named.displayName || named.user })
        this.statusClass = 'status-ok'
        this.reply(link, { ok: true, requestId, message: this.$t('setup.saved'), displayName: named.displayName }, () => {
          this.exitTimer = setTimeout(() => {
            this.exitTimer = null
            if (this.link === link) router.replace({ uri: ROUTE.home })
          }, 1600)
        })
      })
      .catch((err) => {
        this.finish()
        if (this.link !== link) return
        // A timeout here is almost never a wrong password: the watch never got
        // an answer. Say what to check instead of echoing "请求超时".
        const reason = (err && err.code === 'TIMEOUT')
          ? this.$t('setup.timeout')
          : ((err && err.message) || this.$t('setup.failed'))
        // The credentials stay on disk, and the phone must hear that in the
        // same sentence as the failure, otherwise it reads as "nothing saved".
        const message = this.$t('setup.savedUnverified', { message: reason })
        this.setError(message)
        this.reply(link, { ok: false, requestId, message })
      })
  },

  // Every exit from the handoff releases the screen and the busy flag exactly
  // once; the page stays usable for a retry after a failure.
  finish() {
    this.busy = false
    this.keepAwake(false)
  },

  reply(link, payload, onSent) {
    if (this.link !== link) return
    const failed = (_data, code) => {
      if (this.link !== link) return
      console.log('ack failed, code = ' + code)
      if (payload.ok) this.setError(this.$t('setup.ackFailed'))
    }
    try {
      link.connect.send({
        data: protocol.buildAck(payload),
        success: () => { if (this.link === link && onSent) onSent() },
        fail: failed
      })
    } catch (_) {
      failed(null, 'send')
    }
  },

  goBack() {
    // Reached as the first screen there is no page to go back to, so fall
    // through to the manual form instead of doing nothing.
    if (!store.hasAccount(state.settings || {})) {
      router.replace({ uri: ROUTE.login })
      return
    }
    router.back()
  },

  openLogin() {
    router.replace({ uri: ROUTE.login })
  }
}
</script>

<style>
@import "../../common/styles/theme.css";

.head {
  width: 80%;
  height: 118px;
  padding-top: 10px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

/* Status colour is the only signal on this page, so it stays explicit. */
.status {
  width: 90%;
  margin-top: 12px;
  font-size: 22px;
  font-weight: 500;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}

.status-waiting {
  color: #ff7da8;
}

.status-ok {
  color: #7bd88f;
}

.status-error {
  color: #ff8095;
}

.info {
  width: 74%;
  margin-top: 10px;
  border-radius: 28px;
  background-color: #262626;
  flex-direction: column;
}

.info-label {
  margin-left: 20px;
  margin-top: 14px;
}

.info-value {
  width: 84%;
  margin-left: 20px;
  margin-top: 4px;
  margin-bottom: 10px;
  font-size: 22px;
  font-weight: 500;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.hint {
  width: 74%;
  margin-top: 14px;
  font-size: 19px;
  color: #9c9c9c;
  text-align: center;
  line-height: 28px;
}

.actions {
  width: 80%;
  margin-top: auto;
  margin-bottom: 24px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

/* if true: process.env.SHAPE === 'CIRCLE' */
/* Head is narrow on purpose: the chord at the title's depth is ~300 px. The
 * bottom buttons sit inside the ~277 px chord at y=436. */
.head {
  width: 68%;
  height: 130px;
  padding-top: 44px;
}
.info, .hint {
  width: 72%;
}
.actions {
  width: 56%;
  margin-bottom: 44px;
}
/* endif */

/* if true: process.env.SHAPE === 'RECT' */
.app-bg {
  width: 480px;
  height: 640px;
}
.head {
  height: 104px;
  padding-top: 4px;
}
.info, .hint {
  width: 86%;
}
.actions {
  width: 86%;
  margin-bottom: 14px;
}
/* endif */
</style>
