<import name="app-pill" src="../../components/ui/AppPill.ux"></import>

<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/pink.png"></image>

    <div class="head">
      <text class="t-title">{{ $t('index.title') }}</text>
      <text class="t-caption" show="{{accountLabel}}">{{ accountLabel }}</text>
    </div>

    <scroll class="scroll" scroll-y="{{true}}">
      <div class="list">
        <div class="room" for="{{rooms}}" @click="openRoom($idx)">
          <div class="avatar" style="background-color: {{ $item.color }};">
            <text class="avatar-text">{{ $item.initial }}</text>
          </div>
          <div class="mid">
            <text class="room-name">{{ $item.name }}</text>
            <text class="room-preview">{{ $item.preview }}</text>
          </div>
          <div class="right">
            <text class="room-time">{{ $item.time }}</text>
            <div class="badge" show="{{ $item.unread > 0 }}">
              <text class="badge-text">{{ $item.unread > 99 ? '99+' : $item.unread }}</text>
            </div>
          </div>
        </div>

        <div class="empty" show="{{!loading && !checking && !error && rooms.length === 0}}">
          <text class="t-body">{{ $t('index.empty') }}</text>
          <text class="empty-hint">{{ $t('index.emptyHint') }}</text>
        </div>

        <div class="empty" show="{{!loading && !checking && error}}">
          <text class="t-error empty-message">{{ error }}</text>
          <app-pill text="{{ $t('common.retry') }}" width="220px" primary="true" @click="refresh"></app-pill>
        </div>

        <div class="empty" show="{{(loading || checking) && rooms.length === 0}}">
          <text class="empty-hint">{{ $t('index.loading') }}</text>
        </div>
      </div>
    </scroll>

    <div class="footer">
      <app-pill text="{{ $t('index.refresh') }}" width="46%" small="true" @click="refresh"></app-pill>
      <app-pill text="{{ $t('index.settings') }}" width="46%" small="true" @click="openSettings"></app-pill>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import api from '../../common/scripts/api'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import fmt from '../../common/scripts/format'
import network from '../../common/scripts/network'

export default {
  data: {
    rooms: [],
    loading: false,
    checking: false,
    error: '',
    accountLabel: ''
  },

  onInit() {
    this.readyPromise = store.load().then((settings) => {
      state.settings = settings
      api.configure(settings)
      state.ready = store.hasAccount(settings)
      return settings
    })
  },

  // onShow also fires when returning from the chat page, so the list refreshes
  // with the new unread counters without any extra plumbing.
  onShow() {
    const ready = this.readyPromise || Promise.resolve({})
    ready.then((settings) => {
      this.accountLabel = settings.displayName || settings.user || ''
      // The network gate runs once per launch (state.networkChecked); the
      // offline page owns the retry loop, so returning from chat does not pay
      // for another probe.
      const gate = state.networkChecked
        ? Promise.resolve(state.online)
        : this.checkNetwork(settings)
      gate.then((online) => {
        if (!online) {
          router.replace({ uri: '/offline' })
          return
        }
        if (!store.hasAccount(settings)) {
          // First launch: land where the AstroBox plugin can actually reach us.
          // /setup listens on interconnect; /login does not.
          router.replace({ uri: '/setup' })
          return
        }
        this.refresh()
      })
    })
  },

  checkNetwork(settings) {
    this.checking = true
    return network.checkNetwork(settings).then((online) => {
      this.checking = false
      state.networkChecked = true
      state.online = online
      return online
    })
  },

  refresh() {
    if (this.loading || this.checking) return
    if (!api.isConfigured()) {
      router.replace({ uri: '/setup' })
      return
    }

    this.loading = true
    this.error = ''

    api.listConversations()
      .then((rooms) => {
        this.rooms = rooms.map((room) => this.toView(room))
        state.rooms = this.rooms
      })
      .catch((err) => {
        this.error = err && err.message ? err.message : '加载失败'
      })
      .then(() => {
        this.loading = false
      })
  },

  toView(room) {
    const name = room.displayName || room.name || room.token
    return {
      token: room.token,
      name: name,
      preview: fmt.previewWithAuthor(room.lastMessage),
      time: fmt.formatTime(room.lastActivity),
      unread: room.unreadMessages || 0,
      initial: fmt.initials(name),
      color: fmt.colorFor(room.token)
    }
  },

  openRoom(index) {
    const room = this.rooms[index]
    if (!room) return
    state.activeRoom = room
    router.push({
      uri: '/chat',
      params: { token: room.token, name: room.name }
    })
  },

  openSettings() {
    router.push({ uri: '/settings' })
  }
}
</script>

<style>
@import "../../common/styles/theme.css";

/* A card per conversation, like the template's rows: the surface colour is
 * what separates items, so there are no row borders to fight the glow. */
.head {
  height: 108px;
  padding-top: 16px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.scroll {
  flex: 1;
  width: 100%;
}

.list {
  /* Design pixels, not 100%: a <scroll> gives its content no definite width,
   * so percentages inside it collapse (the conversation cards disappeared). */
  width: 480px;
  padding-top: 4px;
  padding-bottom: 8px;
  flex-direction: column;
  align-items: center;
}

.room {
  width: 394px;
  height: 104px;
  margin-top: 10px;
  border-radius: 28px;
  background-color: #262626;
  flex-direction: row;
  align-items: center;
}

.avatar {
  margin-left: 16px;
}

.mid {
  flex: 1;
  margin-left: 14px;
  margin-right: 8px;
  flex-direction: column;
  justify-content: center;
}

.room-name {
  width: 100%;
  font-size: 26px;
  font-weight: 600;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.room-preview {
  width: 100%;
  margin-top: 4px;
  font-size: 19px;
  font-weight: 500;
  color: #9c9c9c;
  lines: 1;
  text-overflow: ellipsis;
}

.right {
  width: 84px;
  margin-right: 16px;
  flex-direction: column;
  align-items: flex-end;
}

.room-time {
  font-size: 17px;
  color: #8a8a8a;
}

.empty {
  width: 374px;
  padding-top: 56px;
  flex-direction: column;
  align-items: center;
}

.empty-hint {
  margin-top: 12px;
  margin-bottom: 20px;
  font-size: 20px;
  color: #9c9c9c;
  text-align: center;
}

.empty-message {
  margin-bottom: 20px;
  font-size: 22px;
  text-align: center;
}

.footer {
  width: 82%;
  margin-bottom: 20px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

/* if true: process.env.SHAPE === 'CIRCLE' */
/* Chord maths, not taste: at depth y the usable width is 2*sqrt(240^2-(240-y)^2)
 * in 480-design units. A 394-wide card therefore cannot start above y=110, and
 * the footer has to be narrow because the chord at y=436 is only ~277. */
.head {
  height: 112px;
  padding-top: 30px;
}
.room {
  height: 98px;
}
.footer {
  width: 52%;
  margin-bottom: 44px;
}
/* endif */

/* if true: process.env.SHAPE === 'RECT' */
.app-bg {
  width: 480px;
  height: 640px;
}
.head {
  height: 92px;
  padding-top: 8px;
}
.room {
  width: 413px;
}
.footer {
  width: 86%;
  margin-bottom: 14px;
}
/* endif */
</style>
