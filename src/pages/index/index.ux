<template>
  <div class="page">
    <div class="header">
      <text class="title">{{ $t('index.title') }}</text>
    </div>

    <scroll class="scroll" scroll-y="{{true}}">
      <div class="list">
        <div class="row" for="{{rooms}}" @click="openRoom($idx)">
          <div class="avatar" style="background-color: {{ $item.color }};">
            <text class="avatar-text">{{ $item.initial }}</text>
          </div>
          <div class="mid">
            <text class="room-name">{{ $item.name }}</text>
            <text class="room-preview">{{ $item.preview }}</text>
          </div>
          <div class="right">
            <text class="room-time">{{ $item.time }}</text>
            <div class="badge" show="{{ $item.unread > 0 }}">
              <text class="badge-text">{{ $item.unread > 99 ? '99+' : $item.unread }}</text>
            </div>
          </div>
        </div>

        <div class="placeholder" show="{{!loading && !error && rooms.length === 0}}">
          <text class="placeholder-title">{{ $t('index.empty') }}</text>
          <text class="placeholder-hint">{{ $t('index.emptyHint') }}</text>
        </div>

        <div class="placeholder" show="{{!loading && error}}">
          <text class="placeholder-error">{{ error }}</text>
          <div class="retry" @click="refresh">
            <text class="retry-text">{{ $t('common.retry') }}</text>
          </div>
        </div>

        <div class="placeholder" show="{{loading && rooms.length === 0}}">
          <text class="placeholder-hint">{{ $t('index.loading') }}</text>
        </div>
      </div>
    </scroll>

    <div class="footer">
      <div class="foot-btn" @click="refresh">
        <text class="foot-text">{{ $t('index.refresh') }}</text>
      </div>
      <div class="foot-btn" @click="openSettings">
        <text class="foot-text">{{ $t('index.settings') }}</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import api from '../../common/scripts/api'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import fmt from '../../common/scripts/format'

export default {
  data: {
    rooms: [],
    loading: false,
    error: ''
  },

  onInit() {
    this.readyPromise = store.load().then((settings) => {
      state.settings = settings
      api.configure(settings)
      state.ready = store.hasAccount(settings)
      return settings
    })
  },

  // onShow also fires when returning from the chat page, so the list refreshes
  // with the new unread counters without any extra plumbing.
  onShow() {
    const ready = this.readyPromise || Promise.resolve({})
    ready.then((settings) => {
      if (!store.hasAccount(settings)) {
        // First launch: land where the AstroBox plugin can actually reach us.
        // /setup listens on interconnect; /login does not.
        router.replace({ uri: '/setup' })
        return
      }
      this.refresh()
    })
  },

  refresh() {
    if (this.loading) return
    if (!api.isConfigured()) {
      router.replace({ uri: '/setup' })
      return
    }

    this.loading = true
    this.error = ''

    api.listConversations()
      .then((rooms) => {
        this.rooms = rooms.map((room) => this.toView(room))
        state.rooms = this.rooms
      })
      .catch((err) => {
        this.error = err && err.message ? err.message : '加载失败'
      })
      .then(() => {
        this.loading = false
      })
  },

  toView(room) {
    const name = room.displayName || room.name || room.token
    return {
      token: room.token,
      name: name,
      preview: fmt.previewWithAuthor(room.lastMessage),
      time: fmt.formatTime(room.lastActivity),
      unread: room.unreadMessages || 0,
      initial: fmt.initials(name),
      color: fmt.colorFor(room.token)
    }
  },

  openRoom(index) {
    const room = this.rooms[index]
    if (!room) return
    state.activeRoom = room
    router.push({
      uri: '/chat',
      params: { token: room.token, name: room.name }
    })
  },

  openSettings() {
    router.push({ uri: '/settings' })
  }
}
</script>

