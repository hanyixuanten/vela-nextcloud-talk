  width: 194px;
  font-size: 18px;
  color: #6f7c8a;
  margin-top: 2px;
  text-overflow: ellipsis;
}

.right {
  width: 86px;
  flex-direction: column;
  align-items: flex-end;
}

.room-time {
  font-size: 16px;
  color: #5b6672;
}

.badge {
  width: 34px;
  height: 28px;
  margin-top: 6px;
  border-radius: 14px;
  background-color: #0082c9;
  justify-content: center;
  align-items: center;
}

.badge-text {
  font-size: 17px;
  color: #ffffff;
}

.placeholder {
  width: 340px;
  padding-top: 60px;
  flex-direction: column;
  align-items: center;
}

.placeholder-title {
  font-size: 24px;
  color: #a9b5c2;
}

.placeholder-hint {
  margin-top: 10px;
  font-size: 18px;
  color: #5b6672;
  text-align: center;
}

