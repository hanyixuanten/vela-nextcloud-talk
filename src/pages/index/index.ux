}

.retry {
  margin-top: 18px;
  height: 48px;
  padding-left: 28px;
  padding-right: 28px;
  border-radius: 24px;
  background-color: #1c2127;
  justify-content: center;
  align-items: center;
}

.retry-text {
  font-size: 20px;
  color: #cbd5e1;
}

.footer {
  width: 240px;
  height: 62px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.foot-btn {
  height: 46px;
  width: 108px;
  border-radius: 23px;
  background-color: #14181d;
  justify-content: center;
  align-items: center;
}

.foot-text {
  font-size: 20px;
  color: #a9b5c2;
}

.room-name, .room-preview {
  lines: 1;
}

/* if true: process.env.SHAPE === 'CIRCLE' */
/* The list and buttons must fit the chord at the top/bottom of their viewports. */
.header {
  width: 260px;
  height: 84px;
  padding-top: 22px;
}
.footer {
  width: 248px;
  height: 88px;
  padding-bottom: 28px;
}
.foot-btn {
  width: 114px;
