<import name="app-pill" src="../../components/ui/AppPill.ux"></import>

<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/pink.png"></image>

    <div class="head">
      <text class="t-title">{{ $t('index.title') }}</text>
      <text class="t-caption" if="{{accountLabel}}">{{ accountLabel }}</text>
    </div>

    <scroll class="scroll" scroll-y="{{true}}">
      <div class="list">
        <div class="room" for="{{rooms}}" @click="openRoom($idx)">
          <div class="avatar" style="background-color: {{ $item.color }};">
            <text class="avatar-text">{{ $item.initial }}</text>
          </div>
          <div class="mid">
            <text class="room-name">{{ $item.name }}</text>
            <text class="room-preview">{{ $item.preview }}</text>
          </div>
          <div class="right">
            <text class="room-time">{{ $item.time }}</text>
            <!-- `if`, not `show`: the hidden badge kept its 30px and pushed the
                 timestamp up out of the row. -->
            <div class="badge" if="{{ $item.unread > 0 }}">
              <text class="badge-text">{{ $item.unread > 99 ? '99+' : $item.unread }}</text>
            </div>
          </div>
        </div>

        <!-- The three placeholders are `if` for the same reason the chat page
             is: a shown=false node still takes its layout height on this Vela
             build, so all three (~300px together) were appended after the last
             card and could be scrolled into as empty space. -->
        <div class="empty" if="{{!loading && !error && rooms.length === 0}}">
          <text class="t-body">{{ $t('index.empty') }}</text>
          <text class="empty-hint">{{ $t('index.emptyHint') }}</text>
        </div>

        <div class="empty" if="{{!loading && error}}">
          <text class="t-error empty-message">{{ error }}</text>
          <app-pill text="{{ $t('common.retry') }}" width="220px" primary="true" @click="refresh"></app-pill>
        </div>

        <div class="empty" if="{{loading && rooms.length === 0}}">
          <text class="empty-hint">{{ $t('index.loading') }}</text>
        </div>
      </div>
    </scroll>

    <div class="footer">
      <app-pill text="{{ $t('index.refresh') }}" width="46%" small="true" @click="refresh"></app-pill>
      <app-pill text="{{ $t('index.settings') }}" width="46%" small="true" @click="openSettings"></app-pill>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import api from '../../common/scripts/api'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import fmt from '../../common/scripts/format'
import { ROUTE } from '../../common/scripts/launch'
import keeperClient from '../../common/scripts/keeperClient'
import { accountKey } from '../../common/scripts/keeper'
import { sharedOf } from '../../common/scripts/shared'

export default {
  data: {
    rooms: [],
    loading: false,
    error: '',
    accountLabel: ''
  },

  onInit() {
    this.readyPromise = store.load().then((settings) => {
      state.settings = settings
      api.configure(settings)
      state.ready = store.hasAccount(settings)
      return settings
    })
    // The keeper service pushes the retained list on connect, which usually
    // lands after onShow has already started the network refresh.
    this.unsubscribe = keeperClient.subscribe((summary) => {
      this.applySummary(summary, state.settings)
    })
  },

  onDestroy() {
    if (typeof this.unsubscribe === 'function') this.unsubscribe()
  },

  // onShow also fires when returning from the chat page, so the list refreshes
  // with the new unread counters without any extra plumbing. The network was
  // already proven by pages/splash before this page was ever built.
  onShow() {
    const ready = this.readyPromise || Promise.resolve({})
    ready.then((settings) => {
      // No "did the gate pass?" check here on purpose. The verdict lives in
      // another bundle's memory (every page gets its own copy of
      // common/scripts/state.js), so any attempt to read it bounced straight
      // back to /splash and looped: 检查网络… → 进入 / → 检查网络… . The gate is
      // advisory anyway — pages/splash sends a definitive `none` to /offline
      // before this page is ever built — so an entry without it (the AstroBox
      // plugin launches pages/index directly) simply fetches and reports its
      // own errors.
      this.accountLabel = settings.displayName || settings.user || ''
      if (!store.hasAccount(settings)) {
        // First launch: land where the AstroBox plugin can actually reach us.
        // /setup listens on interconnect; /login does not.
        router.replace({ uri: ROUTE.setup })
        return
      }
      // Paint the retained list first: on a cold start with no network this is
      // the only thing that can show how much is unread (design.md §11).
      const shared = sharedOf(this, state)
      this.applySummary(shared && shared.backgroundSummary, settings)
      this.refresh()
    })
  },

  /**
   * Render a retained keeper summary while the network answer is still
   * missing. Never overwrites rooms that already came from the server.
   */
  applySummary(summary, settings) {
    if (!summary || !summary.rooms || summary.rooms.length === 0) return
    if (this.rooms.length > 0 || this.loading) return
    // A summary written under another account (or before an account switch)
    // must not leak into this list.
    if (summary.account && summary.account !== accountKey(settings)) return
    this.rooms = summary.rooms.map((room) => ({
      token: room.token,
      name: room.name,
      preview: room.preview,
      time: fmt.formatTime(room.at),
      unread: room.unread || 0,
      initial: fmt.initials(room.name),
      color: fmt.colorFor(room.token)
    }))
  },

  refresh() {
    if (this.loading) return
    if (!api.isConfigured()) {
      router.replace({ uri: ROUTE.setup })
      return
    }

    this.loading = true
    this.error = ''

    api.listConversations()
      .then((rooms) => {
        this.rooms = rooms.map((room) => this.toView(room))
        state.rooms = this.rooms
      })
      .catch((err) => {
        this.error = this.describeError(err)
      })
      .then(() => {
        this.loading = false
      })
  },

  /**
   * A transport failure while the control probe (bilibili) succeeded is not a
   * Wi-Fi problem: the watch is online and this particular host / TLS chain /
   * port is not reachable. Say so instead of leaving a bare "network request
   * failed" on screen.
   */
  describeError(err) {
    const message = err && err.message ? err.message : '加载失败'
    const shared = sharedOf(this, state)
    const control = shared && shared.controlProbe
    if (control && control.ok && err && err.status === 0) {
      return this.$t('index.serverUnreachable') + '：' + message
    }
    return message
  },

  toView(room) {
    const name = room.displayName || room.name || room.token
    return {
      token: room.token,
      name: name,
      preview: fmt.previewWithAuthor(room.lastMessage),
      time: fmt.formatTime(room.lastActivity),
      unread: room.unreadMessages || 0,
      initial: fmt.initials(name),
      color: fmt.colorFor(room.token)
    }
  },

  openRoom(index) {
    const room = this.rooms[index]
    if (!room) return
    state.activeRoom = room
    router.push({
      uri: ROUTE.chat,
      params: { token: room.token, name: room.name }
    })
  },

  openSettings() {
    router.push({ uri: ROUTE.settings })
  }
}
</script>

<style>
@import "../../common/styles/theme.css";

/* A card per conversation, like the template's rows: the surface colour is
 * what separates items, so there are no row borders to fight the glow. */
.head {
  height: 108px;
  padding-top: 16px;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.scroll {
  flex: 1;
  width: 100%;
}

.list {
  /* Design pixels, not 100%: a <scroll> gives its content no definite width,
   * so percentages inside it collapse (the conversation cards disappeared). */
  width: 480px;
  padding-top: 4px;
  padding-bottom: 8px;
  flex-direction: column;
  align-items: center;
}

.room {
  width: 394px;
  height: 104px;
  margin-top: 10px;
  border-radius: 28px;
  background-color: #262626;
  flex-direction: row;
  align-items: center;
}

.avatar {
  margin-left: 16px;
}

.mid {
  flex: 1;
  margin-left: 14px;
  margin-right: 8px;
  flex-direction: column;
  justify-content: center;
}

.room-name {
  width: 100%;
  font-size: 26px;
  font-weight: 600;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.room-preview {
  width: 100%;
  margin-top: 4px;
  font-size: 19px;
  font-weight: 500;
  color: #9c9c9c;
  lines: 1;
  text-overflow: ellipsis;
}

.right {
  width: 84px;
  margin-right: 16px;
  flex-direction: column;
  align-items: flex-end;
}

.room-time {
  font-size: 17px;
  color: #8a8a8a;
}

.empty {
  width: 374px;
  padding-top: 56px;
  flex-direction: column;
  align-items: center;
}

.empty-hint {
  margin-top: 12px;
  margin-bottom: 20px;
  font-size: 20px;
  color: #9c9c9c;
  text-align: center;
}

.empty-message {
  margin-bottom: 20px;
  font-size: 22px;
  text-align: center;
}

.footer {
  width: 82%;
  margin-bottom: 20px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

/* if true: process.env.SHAPE === 'CIRCLE' */
/* Chord maths, not taste: at depth y the usable width is 2*sqrt(240^2-(240-y)^2)
 * in 480-design units. A 394-wide card therefore cannot start above y=110, and
 * the footer has to be narrow because the chord at y=436 is only ~277. */
.head {
  height: 112px;
  padding-top: 30px;
}
.room {
  height: 98px;
}
.footer {
  width: 52%;
  margin-bottom: 44px;
}
/* endif */

/* if true: process.env.SHAPE === 'RECT' */
.app-bg {
  width: 480px;
  height: 640px;
}
.head {
  height: 92px;
  padding-top: 8px;
}
.room {
  width: 413px;
}
.footer {
  width: 86%;
  margin-bottom: 14px;
}
/* endif */
</style>
