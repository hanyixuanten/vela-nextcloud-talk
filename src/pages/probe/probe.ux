<template>
  <!-- Router probe. Deliberately the smallest page in the app: no custom
       component, no i18n, no storage, no network — nothing that could fail on
       its own. If this page opens but 会话 / 设置 do not, the router and the
       calling page are fine and the target page is what breaks (see
       common/scripts/nav.js). If this does not open either, transitions from
       the calling page are refused outright.

       It is reached automatically, only after every navigation form has been
       tried against the real target, so finding it on the watch means exactly
       one thing: "the router works, that page does not". -->
  <div class="probe">
    <text class="probe-title">路由可用</text>
    <text class="probe-hint">目标页打不开</text>
    <div class="probe-back" @click="back">
      <text class="probe-back-text">返回会话列表</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  data: {},

  back() {
    // Deferred: issued inside the tap callback this firmware drops it (that is
    // the whole reason this page exists).
    setTimeout(() => {
      try {
        router.replace({ uri: 'pages/index' })
      } catch (err) {
        console.log('probe: replace threw: ' + ((err && err.message) || err))
      }
    }, 30)
  }
}
</script>

<style>
.probe {
  width: 100%;
  height: 100%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  background-color: #000000;
}

.probe-title {
  font-size: 30px;
  font-weight: 600;
  color: #ffffff;
}

.probe-hint {
  margin-top: 10px;
  font-size: 20px;
  color: #9c9c9c;
}

.probe-back {
  width: 240px;
  height: 56px;
  margin-top: 26px;
  border-radius: 28px;
  background-color: #ff7da8;
  justify-content: center;
  align-items: center;
}

.probe-back-text {
  font-size: 22px;
  font-weight: 600;
  color: #1a1a1a;
}
</style>
