<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="page">
    <!-- Normal state: header, message list, input bar -->
    <div class="main" show="{{!editing}}">
      <div class="header">
        <div class="back" @click="goBack">
          <text class="back-text">‹</text>
        </div>
        <text class="title">{{ title }}{{ error ? ' · ' + $t('chat.offline') : '' }}</text>
      </div>

      <scroll id="chat-scroll" class="scroll" scroll-y="{{true}}">
        <div class="list">
          <div class="msg {{ $item.mine ? 'msg-mine' : '' }} {{ $item.id === actionId ? 'msg-selected' : '' }}" for="{{messages}}" @longpress="selectMessage($item.id)">
            <text class="msg-meta">{{ $item.meta }}</text>
            <text class="msg-text {{ $item.mine ? 'msg-text-mine' : '' }}" style="font-size: {{ fontSize }}px;">{{ $item.text }}</text>
            <text class="reaction-summary" if="{{!!$item.reactionSummary}}">{{ $item.reactionSummary }}</text>
          </div>

          <div class="placeholder" show="{{!loading && !error && !olderCursor && messages.length === 0}}">
            <text class="placeholder-hint">{{ $t('chat.empty') }}</text>
          </div>
          <div class="placeholder" show="{{loading && messages.length === 0}}">
            <text class="placeholder-hint">{{ $t('index.loading') }}</text>
          </div>
          <div class="placeholder" show="{{!loading && error}}">
            <text class="placeholder-error">{{ error }}</text>
          </div>
          <div class="history-action" show="{{olderCursor > 0}}" @click="loadOlder">
            <text class="history-label">{{ loading ? $t('index.loading') : $t('chat.loadolder') }}</text>
          </div>
        </div>
      </scroll>

      <div class="inputbar reply-bar" if="{{actionId > 0}}">
        <div class="reply-open" if="{{actionReplyable && !pickerOpen}}" @click="replyToSelection">
          <text class="reply-label">{{ $t('chat.reply') }}</text>
        </div>
        <div class="reply-open" if="{{actionReactable && !pickerOpen}}" @click="openPicker">
          <text class="reply-label">{{ $t('chat.react') }}</text>
        </div>
        <div class="reply-open" for="{{pickerChoices}}" @click="toggleReaction($item.emoji)">
          <text class="reaction-label">{{ $item.label }}</text>
        </div>
        <div class="reply-clear" @click="closeActions">
          <text class="reply-label">×</text>
        </div>
      </div>
      <div class="inputbar reply-bar" if="{{replyId > 0 && !actionId}}">
        <div class="reply-open" @click="startReply">
          <text class="reply-label">{{ $t('chat.reply') }}</text>
        </div>
        <div class="reply-clear" @click="clearReply">
          <text class="reply-label">×</text>
        </div>
      </div>
      <div class="inputbar" show="{{!browsingHistory && !replyId && !actionId}}" @click="startEdit">
        <text class="input-placeholder">{{ $t('chat.placeholder') }}</text>
      </div>
      <div class="inputbar" show="{{browsingHistory && !replyId && !actionId}}" @click="loadInitial">
        <text class="history-label">{{ $t('chat.backlatest') }}</text>
      </div>
    </div>

    <!-- Typing state: the keyboard occupies 321px, so the list is replaced by
         a compact draft preview. This is the whole reason for the two states. -->
    <div class="editor" show="{{editing}}">
      <!-- Tap the draft preview or the cancel button to close the keyboard. -->
      <div class="editor-head">
        <text class="editor-name" show="{{!replyId}}" @click="stopEdit">{{ title }}</text>
        <div class="reply-bar reply-preview" if="{{replyId > 0 && editing}}">
          <text class="reply-summary" @click="stopEdit">{{ replySummary }}</text>
          <div class="reply-clear" @click="clearReply">
            <text class="reply-label">×</text>
          </div>
        </div>
        <text class="editor-text" @click="stopEdit">{{ draftView || $t('chat.placeholder') }}</text>
      </div>
      <div class="editor-actions">
        <div class="ghost" @click="stopEdit">
          <text class="ghost-text">{{ $t('common.cancel') }}</text>
        </div>
        <div class="ghost ghost-primary" @click="send">
          <text class="ghost-text ghost-primary-text">{{ sending ? $t('chat.sending') : $t('chat.send') }}</text>
        </div>
      </div>
    </div>

    <input-method
      hide="{{!editing}}"
      keyboardtype="{{keyboardType}}"
      <!-- if true: process.env.SHAPE === 'CIRCLE' -->
      screentype="circle"
      <!-- endif -->
      <!-- if true: process.env.SHAPE === 'RECT' -->
      screentype="rect"
      <!-- endif -->
      maxlength="5"
      vibratemode="short"
      @complete="onKeyComplete"
      @delete="onKeyDelete"
    ></input-method>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import api from '../../common/scripts/api'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import fmt from '../../common/scripts/format'

const FONT_SIZES = { small: 20, normal: 23, large: 27 }
const DRAFT_VIEW_LIMIT = 60
const REPLY_VIEW_LIMIT = 48
const PAGE_SIZE = 12
const WINDOW_SIZE = 24
const REACTIONS = ['👍', '❤️', '😂']

function reactionMask(message) {
  const self = message.reactionsSelf
  return Array.isArray(self) ? REACTIONS.reduce((mask, emoji, i) =>
    self.indexOf(emoji) >= 0 ? mask | (1 << i) : mask, 0) : 0
}

function describeReactions(counts, mask) {
  return REACTIONS.map((emoji, i) => {
    const count = counts && counts[emoji]
    return Number.isInteger(count) && count > 0
      ? emoji + (mask & (1 << i) ? '•' : '') + (count > 99 ? '99+' : count)
      : ''
  }).filter(Boolean).join('  ')
}

function isReactionEvent(message) {
  const type = message.systemMessage
  return type === 'reaction' || type === 'reaction_revoked' || type === 'reaction_deleted'
}

function clipDisplay(value, limit) {
  if (value.length <= limit) return value
  const last = value.charCodeAt(limit - 1)
  return value.slice(0, last >= 0xd800 && last <= 0xdbff ? limit - 1 : limit) + '…'
}

function trimLastChar(text) {
  const source = String(text || '')
  if (source.length === 0) return ''
  const last = source.charCodeAt(source.length - 1)
  if (last >= 0xdc00 && last <= 0xdfff && source.length >= 2) {
    return source.slice(0, source.length - 2)
  }
  return source.slice(0, source.length - 1)
}

export default {
  protected: {
    token: '',
    name: ''
  },

  data: {
    title: '',
    messages: [],
    draft: '',
    draftView: '',
    replyId: 0,
    replySummary: '',
    actionId: 0,
    actionReplyable: false,
    actionReactable: false,
    pickerOpen: false,
    pickerChoices: [],
    editing: false,
    loading: false,
    olderCursor: 0,
    browsingHistory: false,
    sending: false,
    error: '',
    fontSize: FONT_SIZES.normal,
    keyboardType: 'QWERTY'
  },

  onInit() {
    const room = state.activeRoom || {}
    this.token = this.token || room.token || ''
    this.title = this.name || room.name || 'Talk'
    this.pollInterval = 15000
    this.timer = null
    this.myUser = ''
    this.forwardCursor = 0
    this.initialised = false
    this.visible = false
    this.reacting = false
    this.receiveGeneration = 0

    this.settingsReady = store.load().then((settings) => {
      state.settings = settings
      api.configure(settings)
      this.myUser = String(settings.user || '').toLowerCase()
      this.fontSize = FONT_SIZES[settings.fontScale] || FONT_SIZES.normal
      this.keyboardType = settings.keyboardType || 'QWERTY'
      this.pollInterval = settings.pollInterval || 15000
    })
  },

  onShow() {
    this.visible = true
    this.refreshSettings().then(() => {
      if (!this.visible) return
      if (!this.token) {
        this.error = this.$t('chat.errtoken')
        return
      }
      if (this.loading || (!this.initialised && !this.receiving)) this.loadInitial()
      else this.schedulePoll(this.pollInterval)
    }).catch((err) => {
      this.loading = false
      this.error = err && err.message ? err.message : '加载失败'
    })
  },

  // Returning from Settings refreshes preferences before resuming message reads.
  refreshSettings() {
    this.settingsReady = this.settingsReady.then(() => store.load()).then((settings) => {
      state.settings = settings
      api.configure(settings)
      this.fontSize = FONT_SIZES[settings.fontScale] || FONT_SIZES.normal
      this.keyboardType = settings.keyboardType || 'QWERTY'
      this.pollInterval = settings.pollInterval || 15000
    })
    return this.settingsReady
  },

  onHide() {
    this.visible = false
    this.receiveGeneration += 1
    this.closeActions()
    this.stopPolling()
    this.receiving = false
    this.loading = false
  },

  onDestroy() {
    this.onHide()
  },

  schedulePoll(delay) {
    this.stopPolling()
    if (!this.visible || this.browsingHistory || this.receiving || this.reacting) return
    this.timer = setTimeout(() => {
      this.timer = null
      if (this.initialised) this.pollOnce()
      else this.loadInitial()
    }, delay)
  },

  stopPolling() {
    if (this.timer !== null) {
      clearTimeout(this.timer)
      this.timer = null
    }
  },

  /* ------------------------------------------------------------------ */
  /* data loading                                                        */
  /* ------------------------------------------------------------------ */

  loadInitial() {
    return this.receive('latest')
  },

  loadOlder() {
    if (!this.olderCursor || this.sending || this.editing) return
    return this.receive('older')
  },

  pollOnce() {
    if (this.browsingHistory) return
    return this.receive('forward')
  },

  // Serialize message reads, including retries and foreground transitions.
  receive(mode) {
    if (!this.visible || !this.token || this.receiving || this.reacting) return
    this.stopPolling()
    this.receiving = true
    const generation = ++this.receiveGeneration
    if (mode !== 'forward') this.closeActions()
    const forward = mode === 'forward'
    const older = mode === 'older'
    const cursor = forward ? this.forwardCursor : (older ? this.olderCursor : 0)
    if (!forward) {
      this.loading = true
      this.error = ''
    }

    return api.getMessages(this.token, {
      lastKnownMessageId: cursor,
      limit: PAGE_SIZE,
      lookIntoFuture: forward
    }).then((result) => {
      if (!this.visible || generation !== this.receiveGeneration) return
      const snapshots = Object.create(null)
      let rawFirst = 0
      let rawLast = 0
      const views = []
      result.messages.forEach((message) => {
        const id = Number(message.id) || 0
        if (id > 0) {
          rawFirst = Math.max(rawFirst, id)
          rawLast = rawLast ? Math.min(rawLast, id) : id
        }
        if (!isReactionEvent(message)) {
          views.push(this.toView(message))
          return
        }
        if (!forward || !message.parent || message.parent.deleted) return
        const parentId = Number(message.parent.id)
        if (parentId > 0 && (!snapshots[parentId] || id > snapshots[parentId].id)) {
          snapshots[parentId] = { id, parent: message.parent }
        }
      })
      views.sort((a, b) => b.id - a.id)
      const first = views.length ? views[0].id : 0
      if (older) {
        // The header may include filtered rows, so a short page is not EOF.
        const previous = result.lastGiven || rawLast
        this.olderCursor = !result.notModified && previous > 0 && previous < cursor ? previous : 0
        this.mergeViews(views.filter((view) => view.id < cursor), true)
        this.browsingHistory = true
        return
      }
      if (!forward) {
        if (this.browsingHistory && this.$element) {
          const scroll = this.$element('chat-scroll')
          if (scroll && scroll.scrollTo) scroll.scrollTo({ top: 0 })
        }
        this.messages = []
        this.forwardCursor = rawFirst || result.lastGiven || 0
        this.olderCursor = result.lastGiven || rawLast
        this.browsingHistory = false
        this.initialised = true
      } else {
        this.forwardCursor = Math.max(cursor, result.lastGiven || 0, rawFirst)
      }
      if (views.length) {
        const trimmed = this.mergeViews(views, false)
        if (forward && (trimmed || !this.olderCursor)) {
          this.olderCursor = this.messages[this.messages.length - 1].id
        }
      }
      if (forward && Object.keys(snapshots).length) {
        this.messages = this.messages.map((row) => {
          const event = snapshots[row.id]
          if (!row.reactable || !event) return row
          const mask = reactionMask(event.parent)
          return Object.assign({}, row, {
            reactionMask: mask,
            reactionSummary: describeReactions(event.parent.reactions, mask)
          })
        })
        if (this.pickerOpen) this.openPicker()
      }
      if (first > (forward ? cursor : 0)) return first
    }).then((id) => {
      if (id && this.visible) return api.markRead(this.token, id).catch(() => undefined)
    }).catch((err) => {
      if (this.visible && !forward) this.error = (err && err.message) || '加载失败'
    }).then(() => {
      if (generation !== this.receiveGeneration) return
      this.receiving = false
      this.loading = false
      this.schedulePoll(this.pollInterval)
    })
  },

  mergeViews(views, keepOldest) {
    if (!views.length) return false
    const all = views.concat(this.messages)
    all.sort((a, b) => b.id - a.id)
    const unique = all.filter((view, i) => i === 0 || all[i - 1].id !== view.id)
    this.messages = keepOldest ? unique.slice(-WINDOW_SIZE) : unique.slice(0, WINDOW_SIZE)
    if (this.actionId && !this.messages.some((row) => row.id === this.actionId)) this.closeActions()
    return unique.length > WINDOW_SIZE
  },

  toView(message) {
    const actorId = String(message.actorId || '').toLowerCase()
    const isSystem = Boolean(message.systemMessage)
    const mine = !isSystem && actorId === this.myUser
    const author = clipDisplay(String(message.actorDisplayName || ''), 48)
    const reactable = !isSystem && message.deleted !== true && (!message.messageType || message.messageType === 'comment')
    const mask = reactable ? reactionMask(message) : 0

    return {
      id: Number(message.id),
      text: clipDisplay(fmt.renderMessage(message), 512),
      meta: mine ? fmt.formatClock(message.timestamp) : author + ' · ' + fmt.formatClock(message.timestamp),
      mine: mine,
      replyable: !isSystem && message.isReplyable === true,
      reactable,
      reactionMask: mask,
      reactionSummary: reactable ? describeReactions(message.reactions, mask) : ''
    }
  },

  /* ------------------------------------------------------------------ */
  /* composing                                                           */
  /* ------------------------------------------------------------------ */

  selectMessage(id) {
    if (!this.visible || !this.initialised || this.loading || this.sending || this.editing || this.reacting) return
    if (!Number.isSafeInteger(id) || id <= 0) return
    const row = this.messages.find((message) => message.id === id)
    if (!row || (!row.replyable && !row.reactable)) return
    this.closeActions()
    this.actionId = id
    this.actionReplyable = row.replyable
    this.actionReactable = row.reactable
  },

  closeActions() {
    this.actionId = 0
    this.actionReplyable = false
    this.actionReactable = false
    this.pickerOpen = false
    this.pickerChoices = []
  },

  replyToSelection() {
    const id = this.actionId
    this.closeActions()
    this.selectReply(id)
    if (this.replyId === id && id > 0) this.startReply()
  },

  openPicker() {
    const row = this.messages.find((message) => message.id === this.actionId)
    if (!row || !row.reactable || this.reacting) return
    this.pickerChoices = REACTIONS.map((emoji, i) => ({
      emoji,
      label: emoji + (row.reactionMask & (1 << i) ? '−' : '')
    }))
    this.pickerOpen = true
  },

  toggleReaction(emoji) {
    const i = REACTIONS.indexOf(emoji)
    if (i < 0 || !this.visible || !this.pickerOpen || this.reacting) return
    if (this.receiving) {
      prompt.showToast({ message: this.$t('index.loading'), duration: 1500 })
      return
    }
    const id = this.actionId
    const row = this.messages.find((message) => message.id === id)
    if (!row || !row.reactable) return
    const bit = 1 << i
    const active = !(row.reactionMask & bit)
    this.reacting = true
    this.stopPolling()
    this.closeActions()
    return api.setReaction(this.token, id, emoji, active).then((counts) => {
      this.messages = this.messages.map((message) => {
        if (message.id !== id) return message
        const mask = active ? message.reactionMask | bit : message.reactionMask & ~bit
        return Object.assign({}, message, {
          reactionMask: mask,
          reactionSummary: counts ? describeReactions(counts, mask) : message.reactionSummary
        })
      })
    }).catch((err) => {
      if (this.visible) prompt.showToast({ message: (err && err.message) || this.$t('chat.reacterror'), duration: 2000 })
    }).then(() => {
      this.reacting = false
      this.schedulePoll(this.pollInterval)
    })
  },

  selectReply(id) {
    if (!this.visible || !this.initialised || this.loading || this.sending || this.editing) return
    if (!Number.isSafeInteger(id) || id <= 0) return
    const row = this.messages.find((message) => message.id === id)
    if (!row || !row.replyable) return
    this.replyId = id
    this.replySummary = clipDisplay(row.text.replace(/\s+/g, ' ').trim(), REPLY_VIEW_LIMIT) || this.$t('chat.reply')
  },

  startReply() {
    if (!this.replyId || this.loading || this.sending) return
    this.editing = true
    this.error = ''
  },

  clearReply() {
    if (this.sending) return
    this.replyId = 0
    this.replySummary = ''
    if (this.browsingHistory) this.stopEdit()
  },

  startEdit() {
    if (!this.initialised || this.loading || this.browsingHistory || this.sending) return
    this.editing = true
    this.error = ''
  },

  stopEdit() {
    if (!this.sending) this.editing = false
  },

  setDraft(value) {
    this.draft = value
    this.draftView =
      value.length > DRAFT_VIEW_LIMIT ? '…' + value.slice(value.length - DRAFT_VIEW_LIMIT) : value
  },

  onKeyComplete(evt) {
    const content = evt && evt.detail ? evt.detail.content : ''
    if (!content || !this.editing || this.sending) return
    this.setDraft(this.draft + content)
  },

  onKeyDelete() {
    if (!this.editing || this.sending) return
    this.setDraft(trimLastChar(this.draft))
  },

  send() {
    const text = String(this.draft || '').trim()
    if (!text || this.sending || (this.browsingHistory && !this.replyId)) return

    this.sending = true
    return api.sendMessage(this.token, text, this.replyId || undefined)
      .then((message) => {
        this.sending = false
        this.clearReply()
        this.setDraft('')
        this.editing = false
        if (this.visible && this.browsingHistory) {
          this.loadInitial()
          return
        }
        if (this.visible && message && message.id) {
          const trimmed = this.mergeViews([this.toView(message)], false)
          if (trimmed || !this.olderCursor) this.olderCursor = this.messages[this.messages.length - 1].id
          // The forward cursor must not skip intervening messages from others.
        }
        this.schedulePoll(0)
      })
      .catch((err) => {
        this.sending = false
        if (!this.visible) return
        prompt.showToast({
          message: (err && err.message) || '发送失败',
          duration: 2000
        })
      })
  },

  goBack() {
    this.onHide()
    router.back()
  }
}
</script>

<style>
.page {
  flex-direction: column;
  width: 100%;
  height: 100%;
  align-items: center;
  background-color: #000000;
}

.main {
  flex: 1;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.header {
  width: 340px;
  height: 56px;
  margin-top: 60px;
  flex-direction: row;
  align-items: center;
}

.back {
  width: 44px;
  height: 44px;
  border-radius: 22px;
  background-color: #14181d;
  justify-content: center;
  align-items: center;
}

.back-text {
  font-size: 26px;
  color: #cbd5e1;
}

.title {
  width: 284px;
  margin-left: 12px;
  font-size: 26px;
  color: #ffffff;
  text-overflow: ellipsis;
}

.scroll {
  flex: 1;
  width: 100%;
}

.list {
  width: 360px;
  margin-left: 60px;
  padding-bottom: 10px;
  flex-direction: column;
}

.msg {
  width: 332px;
  margin-top: 8px;
  padding-left: 14px;
  padding-right: 14px;
  padding-top: 8px;
  padding-bottom: 10px;
  border-radius: 16px;
  background-color: #14181d;
  flex-direction: column;
}

.msg-mine {
  background-color: #073a52;
}

.msg-meta {
  font-size: 15px;
  color: #6f7c8a;
}

.msg-text {
  margin-top: 4px;
  color: #e8eef5;
}

.msg-text-mine {
  text-align: right;
}

.msg-selected {
  background-color: #24526c;
}

.reaction-summary {
  margin-top: 4px;
  color: #b8d9fa;
  font-size: 16px;
}

.reaction-label {
  font-size: 24px;
  color: #ffffff;
}

.placeholder {
  width: 340px;
  padding-top: 40px;
  flex-direction: column;
  align-items: center;
}

.placeholder-hint {
  font-size: 18px;
  color: #5b6672;
  text-align: center;
}

.placeholder-error {
  font-size: 20px;
  color: #ff8a80;
  text-align: center;
}

.history-action {
  align-self: center;
  width: 220px;
  height: 48px;
  margin-bottom: 10px;
  justify-content: center;
  align-items: center;
  border-radius: 20px;
  background-color: #262626;
}

.history-label {
  color: #b8d9fa;
  font-size: 20px;
}

.inputbar {
  width: 248px;
  height: 52px;
  margin-top: 8px;
  margin-bottom: 16px;
  border-radius: 26px;
  background-color: #14181d;
  justify-content: center;
  align-items: center;
}

.input-placeholder {
  font-size: 20px;
  color: #6f7c8a;
}

.editor {
  height: 150px;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.editor-head {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
  padding-bottom: 4px;
}

.editor-name {
  font-size: 17px;
  color: #6f7c8a;
}

.editor-text {
  width: 320px;
  margin-top: 6px;
  font-size: 22px;
  color: #e8eef5;
  text-align: center;
}

.reply-bar {
  flex-direction: row;
  align-items: center;
}

.reply-open {
  flex: 1;
  height: 100%;
  justify-content: center;
  align-items: center;
}

.reply-clear {
  width: 46px;
  height: 100%;
  justify-content: center;
  align-items: center;
}

.reply-preview {
  width: 204px;
  height: 36px;
  border-radius: 18px;
  background-color: #14181d;
}

.reply-label, .reply-summary {
  font-size: 18px;
  color: #b8d9fa;
}

.reply-summary {
  width: 148px;
  margin-left: 10px;
  lines: 1;
  text-overflow: ellipsis;
}

.editor-actions {
  width: 280px;
  margin-top: 12px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.ghost {
  width: 132px;
  height: 46px;
  border-radius: 23px;
  background-color: #1c2127;
  justify-content: center;
  align-items: center;
}

