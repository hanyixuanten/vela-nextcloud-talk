<import name="input-method" src="../../components/InputMethod/InputMethod.ux"></import>

<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/pink.png"></image>

    <!-- Normal state: header, message list, input bar.
         `if`, never `show`: on this Vela build a shown=false node still takes
         its layout height, so the editor (150px), both input bars (2 x 106px)
         and the 148px title bar went over the 480px screen together and
         `flex: 1` on the scroll resolved to 0 — the message list was squeezed
         into a horizontal sliver. -->
    <div class="main" if="{{!editing}}">
      <div class="bar">
        <div class="back" @click="goBack">
          <text class="back-icon">‹</text>
        </div>
        <text class="bar-title">{{ title }}</text>
        <text class="t-caption offline-mark" if="{{error}}">{{ $t('chat.offline') }}</text>
      </div>

      <scroll id="chat-scroll" class="scroll" scroll-y="{{true}}">
        <div class="list">
          <!-- Oldest first: the newest message is the one nearest the input
               bar, which is where a thumb looks first (1.0.15). So the older
               page and every placeholder now sit at the TOP of the list, and
               the list is scrolled to the bottom after every load. -->
          <div class="history-action" if="{{olderCursor > 0}}" @click="loadOlder">
            <text class="history-label">{{ loading ? $t('index.loading') : $t('chat.loadolder') }}</text>
          </div>

          <div class="placeholder" if="{{loading && messages.length === 0}}">
            <text class="placeholder-hint">{{ $t('index.loading') }}</text>
          </div>
          <div class="placeholder" if="{{!loading && error}}" @click="loadInitial">
            <text class="placeholder-error">{{ error }}</text>
            <text class="placeholder-hint">{{ $t('common.retry') }}</text>
          </div>
          <div class="placeholder" if="{{!loading && !error && !olderCursor && messages.length === 0}}">
            <text class="placeholder-hint">{{ $t('chat.empty') }}</text>
          </div>

          <div class="msg {{ $item.mine ? 'msg-mine' : '' }} {{ $item.id === actionId ? 'msg-selected' : '' }}" for="{{messages}}" @longpress="selectMessage($item.id)">
            <text class="msg-meta {{ $item.mine ? 'msg-meta-mine' : '' }}">{{ $item.meta }}</text>
            <!-- One text per visual line, four hand-indexed slots, each a direct
                 child of the bubble with the same shape as the meta line above:
                 a definite width plus `lines: 1` (see .msg-row-normal). Rows are
                 pre-split in splitRows(); four is the preview ceiling and the
                 rest is behind 展开全文 (pages/message), the same split the
                 HyperBilibili reply card uses (fixed-height preview, full text
                 on its own page). Indexed by hand rather than a nested `for`:
                 two `for`s share the `$idx` index key on this firmware and the
                 inner one produced no children. -->
            <text class="msg-row-{{ fontScale }} {{ $item.mine ? 'msg-row-mine' : '' }}" if="{{ $item.rows[0] }}">{{ $item.rows[0] }}</text>
            <text class="msg-row-{{ fontScale }} {{ $item.mine ? 'msg-row-mine' : '' }}" if="{{ $item.rows[1] }}">{{ $item.rows[1] }}</text>
            <text class="msg-row-{{ fontScale }} {{ $item.mine ? 'msg-row-mine' : '' }}" if="{{ $item.rows[2] }}">{{ $item.rows[2] }}</text>
            <text class="msg-row-{{ fontScale }} {{ $item.mine ? 'msg-row-mine' : '' }}" if="{{ $item.rows[3] }}">{{ $item.rows[3] }}</text>
            <!-- Only for clipped messages, and the only tap target that opens
                 the detail page: a tap on the bubble itself stays free for the
                 long-press action sheet to keep owning its own gesture. -->
            <text class="msg-more {{ $item.mine ? 'msg-more-mine' : '' }}" if="{{ $item.more }}" @click="openDetail($item.id)">{{ $t('chat.more') }}</text>
            <text class="reaction-summary" if="{{!!$item.reactionSummary}}">{{ $item.reactionSummary }}</text>
          </div>
        </div>
      </scroll>

      <div class="inputbar reply-bar" if="{{actionId > 0}}">
        <div class="reply-open" if="{{actionReplyable && !pickerOpen}}" @click="replyToSelection">
          <text class="reply-label">{{ $t('chat.reply') }}</text>
        </div>
        <div class="reply-open" if="{{actionReactable && !pickerOpen}}" @click="openPicker">
          <text class="reply-label">{{ $t('chat.react') }}</text>
        </div>
        <div class="reply-open" for="{{pickerChoices}}" @click="toggleReaction($item.emoji)">
          <text class="reaction-label">{{ $item.label }}</text>
        </div>
        <div class="reply-clear" @click="closeActions">
          <text class="reply-label">×</text>
        </div>
      </div>
      <div class="inputbar reply-bar" if="{{replyId > 0 && !actionId}}">
        <div class="reply-open" @click="startReply">
          <text class="reply-label">{{ $t('chat.reply') }}</text>
        </div>
        <div class="reply-clear" @click="clearReply">
          <text class="reply-label">×</text>
        </div>
      </div>
      <div class="inputbar" if="{{!browsingHistory && !replyId && !actionId}}" @click="startEdit">
        <text class="input-placeholder">{{ $t('chat.placeholder') }}</text>
      </div>
      <div class="inputbar" if="{{browsingHistory && !replyId && !actionId}}" @click="loadInitial">
        <text class="history-label">{{ $t('chat.backlatest') }}</text>
      </div>
    </div>

    <!-- Typing state: the keyboard occupies 321px, so the list is replaced by
         a compact draft preview. This is the whole reason for the two states. -->
    <div class="editor" if="{{editing}}">
      <!-- Tap the draft preview or the cancel button to close the keyboard. -->
      <div class="editor-head">
        <text class="editor-name" if="{{!replyId}}" @click="stopEdit">{{ title }}</text>
        <div class="reply-bar reply-preview" if="{{replyId > 0 && editing}}">
          <text class="reply-summary" @click="stopEdit">{{ replySummary }}</text>
          <div class="reply-clear" @click="clearReply">
            <text class="reply-label">×</text>
          </div>
        </div>
        <text class="editor-text" @click="stopEdit">{{ draftView || $t('chat.placeholder') }}</text>
      </div>
      <div class="editor-actions">
        <div class="pill editor-cancel" @click="stopEdit">
          <text class="pill-small-text">{{ $t('common.cancel') }}</text>
        </div>
        <div class="pill pill-primary editor-send" @click="send">
          <text class="pill-small-text">{{ sending ? $t('chat.sending') : $t('chat.send') }}</text>
        </div>
      </div>
    </div>

    <input-method
      hide="{{!editing}}"
      keyboardtype="{{keyboardType}}"
      <!-- if true: process.env.SHAPE === 'CIRCLE' -->
      screentype="circle"
      <!-- endif -->
      <!-- if true: process.env.SHAPE === 'RECT' -->
      screentype="rect"
      <!-- endif -->
      maxlength="5"
      vibratemode="short"
      @complete="onKeyComplete"
      @delete="onKeyDelete"
    ></input-method>
  </div>
</template>

<script>
import prompt from '@system.prompt'
import api from '../../common/scripts/api'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import fmt from '../../common/scripts/format'
import { sharedOf } from '../../common/scripts/shared'
import { ROUTE } from '../../common/scripts/launch'
import nav from '../../common/scripts/nav'
import {
  FONT_METRICS,
  splitRows,
  countRows,
  clipDisplay,
  trimLastChar
} from '../../common/scripts/textlayout'

// Rows shown in a bubble before 「展开全文」 takes over. Four rows is about two
// thirds of the 226px list on the round screen, so a long message still reads as
// a message instead of filling the screen, and the node count per bubble stays
// at four `text` elements instead of six.
const PREVIEW_ROWS = 4
// The detail page shows `text` verbatim, so this is also the longest message the
// app will hold: a 50 000 character paste must not become 1 000 row strings in
// RAM on a watch.
const MESSAGE_LIMIT = 2000
const DRAFT_VIEW_LIMIT = 60
const REPLY_VIEW_LIMIT = 48
const PAGE_SIZE = 12
// Messages kept in the list. 16 is a bit over two screens on the round shape and
// 8 on the rect one, and it is the real memory bound: every row is a text node
// plus a view object, and the watchdog complained at 24 with six rows each.
const WINDOW_SIZE = 16
// A request that outlives the api layer's own timeout by this much has lost its
// answer (no callback, no error). Without a floor like this `receiving` stays
// true forever, and the page then refuses every later read — the conversation
// looks permanently "loading".
const STALE_RECEIVE_MS = api.REQUEST_TIMEOUT_MS + 5000
const REACTIONS = ['👍', '❤️', '😂']
// `scrollTo` clamps to the content height, so "the end" does not have to be
// measured. The deferred second attempt is for the first paint: the content box
// may still be the old one when the list is assigned, and the clamp would then
// stop short of the real bottom (HyperBilibili defers its scroll for the same
// reason — src/pages/message/dmpage, ScrollToEnd + 500ms).
const SCROLL_BOTTOM = 100000
const SCROLL_RETRY_MS = 200

function reactionMask(message) {
  const self = message.reactionsSelf
  return Array.isArray(self) ? REACTIONS.reduce((mask, emoji, i) =>
    self.indexOf(emoji) >= 0 ? mask | (1 << i) : mask, 0) : 0
}

function describeReactions(counts, mask) {
  return REACTIONS.map((emoji, i) => {
    const count = counts && counts[emoji]
    return Number.isInteger(count) && count > 0
      ? emoji + (mask & (1 << i) ? '•' : '') + (count > 99 ? '99+' : count)
      : ''
  }).filter(Boolean).join('  ')
}

function isReactionEvent(message) {
  const type = message.systemMessage
  return type === 'reaction' || type === 'reaction_revoked' || type === 'reaction_deleted'
}

export default {
  // The router hands this page its params through `protected`. On this VM a
  // page may declare `protected`/`public`/`private` **or** `data` — never both:
  //
  //   Error: 页面VM对象中的属性data不可与"public,protected,private"同时存在，
  //          请使用private替换data名称
  //
  // 1.0.4 shipped `protected` + `data` here, so the page VM was never created.
  // The router issued the transition, the target page failed to build, and the
  // list stayed on screen — indistinguishable from a tap that did nothing. It
  // is also why the throwaway probe page (no params, no data) opened fine while
  // this one did not. The state block is `private` for that reason; the same keys, the same
  // reactivity, only a name the VM accepts next to `protected`.
  protected: {
    token: '',
    name: ''
  },

  private: {
    title: '',
    messages: [],
    draft: '',
    draftView: '',
    replyId: 0,
    replySummary: '',
    actionId: 0,
    actionReplyable: false,
    actionReactable: false,
    pickerOpen: false,
    pickerChoices: [],
    editing: false,
    loading: false,
    olderCursor: 0,
    browsingHistory: false,
    sending: false,
    error: '',
    fontScale: 'normal',
    fontSize: FONT_METRICS.normal.size,
    keyboardType: 'QWERTY',
    // Who "mine" means. In account mode that is the Nextcloud user id; in
    // public mode there is no user at all — the guest actor id (sha1 of the
    // Talk session) and, as a fallback, the display name we joined with.
    publicMode: false,
    myActorId: '',
    myName: ''
  },

  onInit() {
    // Router params land on `protected`; the app-level object is the fallback for
    // when they do not arrive (see pages/index.openRoom). It is cleared right
    // away so a later entry without params cannot show a stale room.
    const shared = sharedOf(this, state)
    const pending = (shared && shared.pendingRoom) || state.activeRoom || {}
    if (shared && shared.pendingRoom) shared.pendingRoom = null
    this.token = this.token || pending.token || ''
    this.title = this.name || pending.name || 'Talk'
    this.pollInterval = 15000
    this.timer = null
    this.myUser = ''
    this.forwardCursor = 0
    this.initialised = false
    this.visible = false
    this.reacting = false
    this.receiveGeneration = 0
    this.receiveStartedAt = 0
    this.scrollTimer = null
    this.pendingScroll = false

    this.settingsReady = store.load().then((settings) => {
      state.settings = settings
      api.configure(settings)
      this.applyIdentity(settings)
      this.keyboardType = settings.keyboardType || 'QWERTY'
    })
  },

  onShow() {
    this.visible = true
    // A page that is being (re-)entered is not mid-edit: the keyboard belongs to
    // the foreground session that opened it, so returning from the detail page
    // or from the background must not leave it on screen.
    if (!this.sending) this.editing = false
    this.releaseStaleReceive()
    // First entry already has onInit()'s read in flight; awaiting a second
    // storage read here only put a second round trip between the page appearing
    // and the first message request. Coming back from Settings is the case that
    // actually needs fresh preferences.
    const ready = this.initialised ? this.refreshSettings() : this.settingsReady
    ready.then(() => {
      if (!this.visible) return
      if (!this.token) {
        this.error = this.$t('chat.errtoken')
        return
      }
      if (this.loading || (!this.initialised && !this.receiving)) this.loadInitial()
      else this.schedulePoll(this.pollInterval)
    }).catch((err) => {
      this.loading = false
      this.error = err && err.message ? err.message : '加载失败'
    })
  },

  // Returning from Settings refreshes preferences before resuming message reads.
  refreshSettings() {
    this.settingsReady = this.settingsReady.then(() => store.load()).then((settings) => {
      state.settings = settings
      api.configure(settings)
      this.applyIdentity(settings)
      this.keyboardType = settings.keyboardType || 'QWERTY'
    })
    return this.settingsReady
  },

  /**
   * Work out what "my own message" means for this room.
   *
   * Account mode compares the Nextcloud user id. A guest has none: Talk gives it
   * a random actor id derived from its session (see api.js joinSession), which
   * is persisted next to the session cookies, so the value survives the page
   * change between joining and reading.
   */
  applyIdentity(settings) {
    const s = settings || {}
    this.publicMode = s.mode === 'public'
    this.myUser = this.publicMode ? '' : String(s.user || '').toLowerCase()
    this.myActorId = this.publicMode ? String(s.roomActorId || '').toLowerCase() : ''
    this.myName = this.publicMode ? String(s.roomDisplayName || '') : ''
  },

  /**
   * A guest is identified by its session; when this page never learned the actor
   * id (a fresh session made by another page, or a server that rotated it) the
   * name is the only signal left — and it is only trusted for guest actors, so
   * it cannot claim a logged-in user's message.
   */
  isMine(actorId, message) {
    if (!this.publicMode) return actorId === this.myUser
    if (this.myActorId && actorId === this.myActorId) return true
    if (message && message.actorType && message.actorType !== 'guests') return false
    const name = String((message && message.actorDisplayName) || '')
    return Boolean(this.myName) && name === this.myName
  },

  onHide() {
    this.visible = false
    this.receiveGeneration += 1
    this.closeActions()
    this.stopPolling()
    this.cancelScroll()
    this.receiving = false
    this.loading = false
  },

  onDestroy() {
    // Same body as onHide(), inlined. Calling this.onHide() here threw
    // "TypeError: not a function at onDestroy" on the device right before the
    // firmware logged an out-of-memory warning: by the time a page is destroyed
    // the VM no longer hands out its methods. Whatever still exists is state.
    this.visible = false
    this.receiveGeneration += 1
    this.receiving = false
    this.loading = false
    this.actionId = 0
    this.pickerOpen = false
    this.pickerChoices = []
    if (typeof this.stopPolling === 'function') this.stopPolling()
    else if (this.timer !== null) {
      clearTimeout(this.timer)
      this.timer = null
    }
    // Release the message window explicitly. The page VM is kept alive by the
    // runtime after a destroy long enough to show up in heap reports, and 16
    // view objects (each with four row strings) is the largest thing on it.
    this.messages = []
    this.draft = ''
    this.draftView = ''
    this.replySummary = ''
    if (this.scrollTimer) {
      clearTimeout(this.scrollTimer)
      this.scrollTimer = null
    }
  },

  /**
   * A read whose answer never arrived keeps `receiving` (and the spinner) set
   * for good; receive() then refuses every later call and the page sits on
   * 正在加载… with no way back. The api layer times out at 20s, so anything
   * older than that is stale by definition and has to be released.
   */
  releaseStaleReceive() {
    if (!this.receiving) return
    if (Date.now() - this.receiveStartedAt <= STALE_RECEIVE_MS) return
    console.log('chat: releasing a read that never answered')
    this.receiving = false
    this.loading = false
  },

  schedulePoll(delay) {
    this.stopPolling()
    this.releaseStaleReceive()
    if (!this.visible || this.browsingHistory || this.receiving || this.reacting) return
    this.timer = setTimeout(() => {
      this.timer = null
      if (this.initialised) this.pollOnce()
      else this.loadInitial()
    }, delay)
  },

  stopPolling() {
    if (this.timer !== null) {
      clearTimeout(this.timer)
      this.timer = null
    }
  },

  /* ------------------------------------------------------------------ */
  /* data loading                                                        */
  /* ------------------------------------------------------------------ */

  loadInitial() {
    return this.receive('latest')
  },

  loadOlder() {
    if (!this.olderCursor || this.sending || this.editing) return
    return this.receive('older')
  },

  pollOnce() {
    if (this.browsingHistory) return
    return this.receive('forward')
  },

  // Serialize message reads, including retries and foreground transitions.
  receive(mode) {
    this.releaseStaleReceive()
    if (!this.visible || !this.token || this.receiving || this.reacting) return
    this.stopPolling()
    this.receiving = true
    this.receiveStartedAt = Date.now()
    const generation = ++this.receiveGeneration
    if (mode !== 'forward') this.closeActions()
    const forward = mode === 'forward'
    const older = mode === 'older'
    const cursor = forward ? this.forwardCursor : (older ? this.olderCursor : 0)
    if (!forward) {
      this.loading = true
      this.error = ''
    }

    return api.getMessages(this.token, {
      lastKnownMessageId: cursor,
      limit: PAGE_SIZE,
      lookIntoFuture: forward
    }).then((result) => {
      if (!this.visible || generation !== this.receiveGeneration) return
      const snapshots = Object.create(null)
      let rawFirst = 0
      let rawLast = 0
      // Highest id that is a real message (reaction events excluded): the read
      // marker must never move to an event id, but it must still cover a message
      // that was already on screen (e.g. the one this page just sent).
      let newestSeen = 0
      const views = []
      // In forward mode the list already holds most of what comes back (the
      // server answers with the unchanged tail as well). Converting those again
      // would re-split every row on every 15s poll — steady allocation churn on
      // a device that has already logged an OOM warning — so only unknown ids
      // are turned into views. `older`/`latest` rebuild their page in full.
      const known = Object.create(null)
      if (forward) {
        this.messages.forEach((row) => { known[row.id] = true })
      }
      result.messages.forEach((message) => {
        const id = Number(message.id) || 0
        if (id > 0) {
          rawFirst = Math.max(rawFirst, id)
          rawLast = rawLast ? Math.min(rawLast, id) : id
        }
        if (!isReactionEvent(message)) {
          newestSeen = Math.max(newestSeen, id)
          if (!known[id]) views.push(this.toView(message))
          return
        }
        if (!forward || !message.parent || message.parent.deleted) return
        const parentId = Number(message.parent.id)
        if (parentId > 0 && (!snapshots[parentId] || id > snapshots[parentId].id)) {
          snapshots[parentId] = { id, parent: message.parent }
        }
      })
      // Oldest first: the list is read top-down and the newest row is the one
      // next to the input bar.
      views.sort((a, b) => a.id - b.id)
      const newest = views.length ? views[views.length - 1].id : 0
      if (older) {
        // The header may include filtered rows, so a short page is not EOF.
        const previous = result.lastGiven || rawLast
        this.olderCursor = !result.notModified && previous > 0 && previous < cursor ? previous : 0
        this.mergeViews(views.filter((view) => view.id < cursor), true)
        this.browsingHistory = true
        // History is prepended at the top, which pushes everything down without
        // moving the scroll offset; jump to the top so the newly loaded page is
        // the thing on screen instead of a mid-list slice.
        this.scrollToTop()
        return
      }
      if (!forward) {
        this.messages = []
        this.forwardCursor = rawFirst || result.lastGiven || 0
        this.olderCursor = result.lastGiven || rawLast
        this.browsingHistory = false
        this.initialised = true
      } else {
        this.forwardCursor = Math.max(cursor, result.lastGiven || 0, rawFirst)
      }
      if (views.length) {
        const trimmed = this.mergeViews(views, false)
        if (forward && (trimmed || !this.olderCursor)) {
          // The oldest row is now the head of the list.
          this.olderCursor = this.messages[0].id
        }
      }
      if (forward && Object.keys(snapshots).length) {
        this.messages = this.messages.map((row) => {
          const event = snapshots[row.id]
          if (!row.reactable || !event) return row
          const mask = reactionMask(event.parent)
          return Object.assign({}, row, {
            reactionMask: mask,
            reactionSummary: describeReactions(event.parent.reactions, mask)
          })
        })
        if (this.pickerOpen) this.openPicker()
      }
      if (!forward || newest > cursor) this.scrollToLatest()
      const readId = Math.max(newestSeen, newest)
      if (readId > (forward ? cursor : 0)) return readId
    }).then((id) => {
      if (id && this.visible) return api.markRead(this.token, id).catch(() => undefined)
    }).catch((err) => {
      if (this.visible && !forward) this.error = (err && err.message) || '加载失败'
    }).then(() => {
      if (generation !== this.receiveGeneration) return
      this.receiving = false
      this.loading = false
      this.schedulePoll(this.pollInterval)
    })
  },

  /**
   * Merge `views` into the window, oldest first.
   *
   * `keepOldest` is what 加载更早 needs: the caller is browsing backwards, so the
   * window must keep the *oldest* rows (the head of the array) instead of the
   * newest ones. Everything else keeps the tail, because the newest message is
   * the one the user is looking at.
   */
  mergeViews(views, keepOldest) {
    if (!views.length) return false
    const all = views.concat(this.messages)
    all.sort((a, b) => a.id - b.id)
    const unique = all.filter((view, i) => i === 0 || all[i - 1].id !== view.id)
    this.messages = keepOldest ? unique.slice(0, WINDOW_SIZE) : unique.slice(-WINDOW_SIZE)
    if (this.actionId && !this.messages.some((row) => row.id === this.actionId)) this.closeActions()
    return unique.length > WINDOW_SIZE
  },

  /* ------------------------------------------------------------------ */
  /* scrolling                                                           */
  /* ------------------------------------------------------------------ */

  cancelScroll() {
    if (this.scrollTimer) {
      clearTimeout(this.scrollTimer)
      this.scrollTimer = null
    }
    this.pendingScroll = false
  },

  /**
   * Jump to the newest message (the bottom of the list).
   *
   * `scrollTo` clamps to the content height, so the value can be "past the end".
   * It is repeated once after SCROLL_RETRY_MS: on the first paint the content box
   * may still have the old height, and the clamp would then stop short — the
   * same reason HyperBilibili defers its ScrollToEnd by 500ms.
   */
  scrollToLatest() {
    const scroll = this.$element && this.$element('chat-scroll')
    if (!scroll || typeof scroll.scrollTo !== 'function') return
    const jump = () => {
      try {
        scroll.scrollTo({ top: SCROLL_BOTTOM })
      } catch (err) {
        console.log('chat: scrollTo failed: ' + ((err && err.message) || err))
      }
    }
    jump()
    // One pending scroll at a time; a second load inside 200ms supersedes it.
    this.cancelScroll()
    this.pendingScroll = true
    this.scrollTimer = setTimeout(() => {
      this.scrollTimer = null
      if (!this.pendingScroll) return
      this.pendingScroll = false
      jump()
    }, SCROLL_RETRY_MS)
  },

  scrollToTop() {
    const scroll = this.$element && this.$element('chat-scroll')
    if (!scroll || typeof scroll.scrollTo !== 'function') return
    try {
      scroll.scrollTo({ top: 0 })
    } catch (err) {
      console.log('chat: scrollTo failed: ' + ((err && err.message) || err))
    }
  },

  toView(message) {
    const actorId = String(message.actorId || '').toLowerCase()
    const isSystem = Boolean(message.systemMessage)
    const mine = !isSystem && this.isMine(actorId, message)
    const author = clipDisplay(String(message.actorDisplayName || ''), 48)
    const reactable = !isSystem && message.deleted !== true && (!message.messageType || message.messageType === 'comment')
    const mask = reactable ? reactionMask(message) : 0
    // The full text is kept (up to MESSAGE_LIMIT) because the detail page shows
    // it verbatim; only the bubble is clipped, and by rows rather than by
    // characters, so the cut is at a line boundary the reader can see.
    const text = clipDisplay(fmt.renderMessage(message), MESSAGE_LIMIT)
    const rows = splitRows(text, this.fontSize, PREVIEW_ROWS)

    return {
      id: Number(message.id),
      text: text,
      // Pre-split: the template renders one <text lines="1"> per row.
      rows: rows,
      // `more` drives the 展开全文 line and is why the bubble never silently
      // eats the second half of a message.
      more: countRows(text, this.fontSize) > PREVIEW_ROWS,
      meta: mine ? fmt.formatClock(message.timestamp) : author + ' · ' + fmt.formatClock(message.timestamp),
      mine: mine,
      replyable: !isSystem && message.isReplyable === true,
      reactable,
      reactionMask: mask,
      reactionSummary: reactable ? describeReactions(message.reactions, mask) : ''
    }
  },

  /**
   * Open the full message, the way HyperBilibili opens a long comment: the card
   * is a fixed-height preview and the whole text lives on `pages/message`
   * (`pages/tools/textdetail` there). Router params carry the text; `shared`
   * carries the same object for the params-less rung of the navigate ladder
   * (see pages/message onInit).
   */
  openDetail(id) {
    if (!this.visible || this.sending || this.editing || this.reacting) return
    const row = this.messages.find((message) => message.id === id)
    if (!row) return
    const detail = { text: row.text, meta: row.meta, scale: this.fontScale }
    const shared = sharedOf(this, state)
    if (shared && shared !== state) shared.pendingDetail = detail
    nav.navigate(this, ROUTE.message, detail, this.$t('common.openFailed'))
  },

  /* ------------------------------------------------------------------ */
  /* composing                                                           */
  /* ------------------------------------------------------------------ */

  selectMessage(id) {
    if (!this.visible || !this.initialised || this.loading || this.sending || this.editing || this.reacting) return
    if (!Number.isSafeInteger(id) || id <= 0) return
    const row = this.messages.find((message) => message.id === id)
    if (!row || (!row.replyable && !row.reactable)) return
    this.closeActions()
    this.actionId = id
    this.actionReplyable = row.replyable
    this.actionReactable = row.reactable
  },

  closeActions() {
    this.actionId = 0
    this.actionReplyable = false
    this.actionReactable = false
    this.pickerOpen = false
    this.pickerChoices = []
  },

  replyToSelection() {
    const id = this.actionId
    this.closeActions()
    this.selectReply(id)
    if (this.replyId === id && id > 0) this.startReply()
  },

  openPicker() {
    const row = this.messages.find((message) => message.id === this.actionId)
    if (!row || !row.reactable || this.reacting) return
    this.pickerChoices = REACTIONS.map((emoji, i) => ({
      emoji,
      label: emoji + (row.reactionMask & (1 << i) ? '−' : '')
    }))
    this.pickerOpen = true
  },

  toggleReaction(emoji) {
    const i = REACTIONS.indexOf(emoji)
    if (i < 0 || !this.visible || !this.pickerOpen || this.reacting) return
    if (this.receiving) {
      prompt.showToast({ message: this.$t('index.loading'), duration: 1500 })
      return
    }
    const id = this.actionId
    const row = this.messages.find((message) => message.id === id)
    if (!row || !row.reactable) return
    const bit = 1 << i
    const active = !(row.reactionMask & bit)
    this.reacting = true
    this.stopPolling()
    this.closeActions()
    return api.setReaction(this.token, id, emoji, active).then((counts) => {
      this.messages = this.messages.map((message) => {
        if (message.id !== id) return message
        const mask = active ? message.reactionMask | bit : message.reactionMask & ~bit
        return Object.assign({}, message, {
          reactionMask: mask,
          reactionSummary: counts ? describeReactions(counts, mask) : message.reactionSummary
        })
      })
    }).catch((err) => {
      if (this.visible) prompt.showToast({ message: (err && err.message) || this.$t('chat.reacterror'), duration: 2000 })
    }).then(() => {
      this.reacting = false
      this.schedulePoll(this.pollInterval)
    })
  },

  selectReply(id) {
    if (!this.visible || !this.initialised || this.loading || this.sending || this.editing) return
    if (!Number.isSafeInteger(id) || id <= 0) return
    const row = this.messages.find((message) => message.id === id)
    if (!row || !row.replyable) return
    this.replyId = id
    this.replySummary = clipDisplay(row.text.replace(/\s+/g, ' ').trim(), REPLY_VIEW_LIMIT) || this.$t('chat.reply')
  },

  startReply() {
    if (!this.replyId || this.loading || this.sending) return
    this.editing = true
    this.error = ''
  },

  clearReply() {
    if (this.sending) return
    this.replyId = 0
    this.replySummary = ''
    if (this.browsingHistory) this.stopEdit()
  },

  startEdit() {
    if (!this.initialised || this.loading || this.browsingHistory || this.sending) return
    this.editing = true
    this.error = ''
  },

  stopEdit() {
    if (!this.sending) this.editing = false
  },

  setDraft(value) {
    this.draft = value
    this.draftView =
      value.length > DRAFT_VIEW_LIMIT ? '…' + value.slice(value.length - DRAFT_VIEW_LIMIT) : value
  },

  onKeyComplete(evt) {
    const content = evt && evt.detail ? evt.detail.content : ''
    if (!content || !this.editing || this.sending) return
    this.setDraft(this.draft + content)
  },

  onKeyDelete() {
    if (!this.editing || this.sending) return
    this.setDraft(trimLastChar(this.draft))
  },

  send() {
    const text = String(this.draft || '').trim()
    if (!text || this.sending || (this.browsingHistory && !this.replyId)) return

    this.sending = true
    return api.sendMessage(this.token, text, this.replyId || undefined)
      .then((message) => {
        this.sending = false
        this.clearReply()
        this.setDraft('')
        this.editing = false
        if (this.visible && this.browsingHistory) {
          this.loadInitial()
          return
        }
        if (this.visible && message && message.id) {
          const trimmed = this.mergeViews([this.toView(message)], false)
          if (trimmed || !this.olderCursor) this.olderCursor = this.messages[0].id
          // The forward cursor must not skip intervening messages from others.
          this.scrollToLatest()
        }
        this.schedulePoll(0)
      })
      .catch((err) => {
        this.sending = false
        if (!this.visible) return
        prompt.showToast({
          message: (err && err.message) || '发送失败',
          duration: 2000
        })
      })
  },

  goBack() {
    // Pause, but do not declare the page hidden yet. onHide() sets `visible`
    // false, and when the transition is then dropped the page stays on screen
    // while refusing every later read — a dead page with a dead button. The
    // pause is restored in the callback if nav.leave() cannot get us out.
    this.stopPolling()
    this.receiveGeneration += 1
    this.receiving = false
    this.loading = false
    this.closeActions()
    // This page may have been installed with replace() rather than push() (see
    // common/scripts/nav.js), so back() alone is not enough.
    nav.leave(ROUTE.home, () => {
      this.visible = true
      prompt.showToast({ message: this.$t('chat.backfailed'), duration: 2000 })
      this.schedulePoll(this.pollInterval)
    })
  }
}
</script>

<style>
@import "../../common/styles/theme.css";

.main {
  flex: 1;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.bar {
  margin-top: 10px;
  margin-bottom: 6px;
}

.offline-mark {
  margin-left: 8px;
}

/* Fixed design height, never `flex: 1`.
 *
 * This is the one thing every page here got wrong and the HyperBilibili template
 * (src/less/global.less) gets right: its `.scroll` is `width/height: 100%` of a
 * page root with an explicit height, i.e. the scroll owns a *definite* pixel
 * box and its content is free to be taller than that box. With `flex: 1` this
 * firmware resolves the viewport height and then *shrinks the content to fit*
 * instead of letting it overflow: the list never scrolls, every bubble is
 * compressed on the main axis, and a compressed text measures 0 tall. That is
 * the "长条" — not a text-layout bug at all.
 *
 * 480 - (10+72+6 bar + 8+58+18 input) = 308; the CIRCLE and RECT blocks override
 * with their own chrome. */
.scroll {
  width: 480px;
  height: 308px;
  flex-direction: column;
  align-items: center;
}

.list {
  /* Width in design pixels, not 100%: inside a <scroll> there is no definite
   * parent width, so a percentage here collapsed the list and every bubble in
   * it (the "squashed" chat screen). 480px is the design width of both shapes. */
  width: 480px;
  padding-bottom: 8px;
  flex-direction: column;
  align-items: center;
}

/* Bubbles, template colours: grey surface for others, the single pink accent
 * for your own messages (dark text keeps it readable on pink). */
.msg {
  width: 394px;
  margin-top: 10px;
  /* Bottom spacing lives here: a row cannot know it is the last one, and the
   * meta line only has a top margin. */
  padding-bottom: 12px;
  border-radius: 26px;
  background-color: #262626;
  flex-direction: column;
  /* Children carry their own pixel width (see below); this only makes the
   * cross-axis rule explicit instead of relying on this build's default. */
  align-items: flex-start;
}

.msg-mine {
  background-color: #ff7da8;
}

.msg-selected {
  background-color: #3b3b3b;
}

/* The meta line: 16px, one line, ellipsis. The reference shape for everything
 * else in a bubble — width in pixels, font size and line count in one block. */
.msg-meta {
  width: 362px;
  margin-left: 16px;
  margin-right: 16px;
  margin-top: 12px;
  /* The first row follows directly, like a subtitle under a name. */
  margin-bottom: 2px;
  font-size: 16px;
  font-weight: 500;
  color: #9c9c9c;
  lines: 1;
  text-overflow: ellipsis;
}

.msg-meta-mine {
  color: #56232f;
}

/* The body is a column of single-line rows, pre-split in splitRows(). Each row is
 * a direct child of the bubble and its style block is self-contained and the
 * same shape as .msg-meta:
 *
 *   width + side margins + font-size + lines: 1, all in ONE block
 *
 * Self-contained on purpose: a text whose font size comes from a second class,
 * or from an inline style, is one more thing that has to be trusted on a
 * firmware that has already surprised us repeatedly. The font size is fixed per
 * class (the Settings switch picks one of these three complete blocks) and the
 * row height follows from the font itself. */
.msg-row-small {
  width: 362px;
  margin-left: 16px;
  margin-right: 16px;
  margin-top: 1px;
  font-size: 20px;
  font-weight: 500;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.msg-row-normal {
  width: 362px;
  margin-left: 16px;
  margin-right: 16px;
  margin-top: 1px;
  font-size: 23px;
  font-weight: 500;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.msg-row-large {
  width: 362px;
  margin-left: 16px;
  margin-right: 16px;
  margin-top: 1px;
  font-size: 27px;
  font-weight: 500;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.msg-row-mine {
  color: #1a1a1a;
  text-align: right;
}

/* The 展开全文 line, the only tap target inside a bubble (the bubble itself
 * belongs to the long-press action sheet). Same self-contained shape as a row:
 * pixel width, font size and `lines: 1` in one block. */
.msg-more {
  width: 362px;
  margin-left: 16px;
  margin-right: 16px;
  margin-top: 4px;
  font-size: 18px;
  font-weight: 600;
  color: #ff7da8;
  lines: 1;
  text-overflow: ellipsis;
}

.msg-more-mine {
  color: #56232f;
  text-align: right;
}
.reaction-summary {
  width: 362px;
  margin-left: 16px;
  margin-right: 16px;
  margin-bottom: 12px;
  font-size: 17px;
  color: #ffb3c8;
  /* Three reactions at most (see REACTIONS), so one line is enough and keeps
   * every text inside a bubble on the shape that is known to render. */
  lines: 1;
  text-overflow: ellipsis;
}

.reaction-label {
  font-size: 26px;
  color: #ffffff;
}

.placeholder {
  width: 374px;
  padding-top: 48px;
  flex-direction: column;
  align-items: center;
}

/* Same rule as the bubble texts: a width, or a server error stays on one line
 * and runs off the 374px block it lives in. */
.placeholder-hint {
  width: 374px;
  font-size: 20px;
  color: #9c9c9c;
  text-align: center;
}

.placeholder-error {
  width: 374px;
  font-size: 21px;
  color: #ff8095;
  text-align: center;
}

.history-action {
  width: 220px;
  height: 52px;
  margin-top: 14px;
  border-radius: 26px;
  background-color: #262626;
  justify-content: center;
  align-items: center;
}

.history-label {
  font-size: 20px;
  font-weight: 600;
  color: #ff7da8;
}

.inputbar {
  width: 72%;
  height: 58px;
  margin-top: 8px;
  margin-bottom: 18px;
  border-radius: 29px;
  background-color: #262626;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.input-placeholder {
  font-size: 21px;
  color: #9c9c9c;
}

.editor {
  height: 150px;
  width: 100%;
  flex-direction: column;
  align-items: center;
}

.editor-head {
  flex: 1;
  width: 100%;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.editor-name {
  width: 78%;
  font-size: 18px;
  color: #9c9c9c;
  text-align: center;
  lines: 1;
  text-overflow: ellipsis;
}

.editor-text {
  width: 78%;
  margin-top: 8px;
  font-size: 26px;
  font-weight: 500;
  color: #ffffff;
  text-align: center;
  lines: 2;
  text-overflow: ellipsis;
}

.reply-bar {
  flex-direction: row;
  align-items: center;
}

.reply-open {
  flex: 1;
  height: 100%;
  justify-content: center;
  align-items: center;
}

.reply-clear {
  width: 48px;
  height: 100%;
  justify-content: center;
  align-items: center;
}

.reply-preview {
  width: 200px;
  height: 38px;
  border-radius: 19px;
  background-color: #1f1f1f;
}

.reply-label {
  font-size: 20px;
  font-weight: 600;
  color: #ff7da8;
}

.reply-summary {
  width: 146px;
  margin-left: 12px;
  font-size: 18px;
  color: #d9d9d9;
  lines: 1;
  text-overflow: ellipsis;
}

.editor-actions {
  width: 78%;
  margin-top: 14px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.editor-cancel, .editor-send {
  width: 46%;
  height: 58px;
}

/* if true: process.env.SHAPE === 'CIRCLE' */
/* Same chord limits as the list page: the bar starts at y=70 (chord ~340, so
 * the bar is 70% wide) and the input pill has to stay inside the ~277 px chord
 * at y=436, which caps it at about half the screen. */
.bar {
  width: 70%;
  margin-top: 70px;
}
.msg {
  width: 394px;
}
/* 480 - (70+72+6 bar) - (8+58+40 input) = 226 */
.scroll {
  height: 226px;
}
.inputbar {
  width: 50%;
  margin-bottom: 40px;
}
.editor-text {
  width: 62%;
}
.editor-name {
  width: 62%;
}
.editor-actions {
  width: 62%;
}
/* endif */

/* if true: process.env.SHAPE === 'RECT' */
.app-bg {
  width: 480px;
  height: 640px;
}
.bar {
  width: 86%;
}
/* 640 - (10+72+6 bar) - (8+62+16 input) = 466 */
.scroll {
  height: 466px;
}
.msg {
  width: 413px;
}
/* 413 - 16 - 16, see the base .msg-row-normal comment. */
.msg-meta {
  width: 381px;
}
.msg-row-small {
  width: 381px;
}
.msg-row-normal {
  width: 381px;
}
.msg-row-large {
  width: 381px;
}
.msg-more {
  width: 381px;
}
.reaction-summary {
  width: 381px;
}
/* The RECT block used to put `align-self: flex-end` on .msg-mine. This
 * firmware logs "Unknown style - alignSelf" and ignores it, so own bubbles have
 * always been full width on both shapes; the rule is gone rather than left to
 * print that line on every render. */
.inputbar {
  width: 78%;
  height: 62px;
  border-radius: 31px;
  margin-bottom: 16px;
}
.editor {
  height: 246px;
}
.editor-name, .editor-text {
  width: 86%;
}
.editor-text {
  lines: 3;
}
.editor-actions {
  width: 86%;
}
/* endif */
</style>
