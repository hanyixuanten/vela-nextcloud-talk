  width: 96px;
  height: 96px;
  border-radius: 48px;
  background-color: #3a1f28;
  justify-content: center;
  align-items: center;
}

.mark-text {
  font-size: 56px;
  font-weight: 600;
  color: #ff7da8;
}

.headline {
  margin-top: 22px;
  text-align: center;
}

.detail {
  margin-top: 14px;
  font-size: 20px;
  line-height: 30px;
  text-align: center;
}

.actions {
  width: 100%;
  padding-bottom: 34px;
  flex-direction: column;
  align-items: center;
}

/* if true: process.env.SHAPE === 'RECT' */
.app-bg {
  width: 480px;
  height: 640px;
}
.body {
  width: 86%;
}
.actions {
  padding-bottom: 20px;
}
/* endif */
</style>
