<import name="app-pill" src="../../components/ui/AppPill.ux"></import>

<!-- Startup gate: the app does not go any further while the watch has no
     network. Same layout as the template's networkerror page — one headline,
     one explanation, one primary action — because a watch screen fits nothing
     more. -->
<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/blue.png"></image>

    <div class="body">
      <div class="mark">
        <text class="mark-text">!</text>
      </div>
      <text class="t-title headline">{{ $t('offline.title') }}</text>
      <text class="t-caption detail">{{ checking ? $t('offline.checking') : $t('offline.hint') }}</text>
    </div>

    <div class="actions">
      <app-pill text="{{ checking ? $t('offline.checking') : $t('offline.retry') }}"
                width="70%" primary="true" busy="{{checking}}" @click="retry"></app-pill>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import network from '../../common/scripts/network'

export default {
  data: {
    checking: false
  },

  onShow() {
    // Coming back here means the previous verdict was "offline": the next
    // retry must actually probe again instead of trusting the cached one.
    state.online = false
    state.networkChecked = false
  },

  retry() {
    if (this.checking) return
    this.checking = true
    const settings = state.settings || {}
    network.checkNetwork(settings).then((online) => {
      this.checking = false
      state.online = online
      state.networkChecked = true
      if (!online) return
      // Back through the entry page so the normal launch path (account check →
      // setup or conversation list) runs exactly once.
      router.replace({ uri: '/' })
    })
  }
}
</script>

<style>
@import "../../common/styles/theme.css";

.body {
  flex: 1;
  width: 78%;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.mark {
  width: 96px;
  height: 96px;
  border-radius: 48px;
  background-color: #3a1f28;
  justify-content: center;
  align-items: center;
}

.mark-text {
  font-size: 56px;
  font-weight: 600;
  color: #ff7da8;
}

.headline {
  margin-top: 22px;
  text-align: center;
}

.detail {
  margin-top: 14px;
  font-size: 20px;
  line-height: 30px;
  text-align: center;
}

.actions {
  width: 100%;
  padding-bottom: 34px;
  flex-direction: column;
  align-items: center;
}

/* if true: process.env.SHAPE === 'RECT' */
.body {
  width: 86%;
}
.actions {
  padding-bottom: 20px;
}
/* endif */
</style>
