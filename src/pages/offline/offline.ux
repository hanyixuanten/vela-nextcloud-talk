<import name="app-pill" src="../../components/ui/AppPill.ux"></import>

<!-- The only screen a failed launch gate can reach: no conversation list, no
     settings, no chat — just what went wrong and one way back. Same layout as
     the template's networkerror page (one headline, one explanation, one
     primary action) because a watch screen fits nothing more. -->
<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/blue.png"></image>

    <div class="body">
      <div class="mark">
        <text class="mark-text">!</text>
      </div>
      <text class="t-title headline">{{ $t('offline.title') }}</text>
      <text class="t-caption detail">{{ $t('offline.hint') }}</text>
    </div>

    <div class="actions">
      <app-pill text="{{ $t('offline.retry') }}" width="70%" primary="true" @click="retry"></app-pill>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import state from '../../common/scripts/state'
import { ROUTE } from '../../common/scripts/launch'

export default {
  // No probe of its own: retry hands control back to the launch gate, which
  // owns the single verdict and the "checking" screen. Two probes here would
  // mean waiting out the 8 s timeout twice on a dead network.
  onShow() {
    // Coming back here means the previous verdict was "offline": the next
    // pass through the gate must probe again instead of trusting the cache.
    // Nothing to invalidate: the gate publishes no verdict, retry simply runs
    // the gate again (it owns the only probe and the only verdict).
  },

  retry() {
    router.replace({ uri: ROUTE.splash })
  }
}
</script>

<style>
