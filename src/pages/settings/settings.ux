<import name="app-pill" src="../../components/ui/AppPill.ux"></import>

<template>
  <div class="app-page">
    <image class="app-bg" src="/common/images/bg/blue.png"></image>

    <div class="bar">
      <div class="back" @click="goBack">
        <text class="back-icon">‹</text>
      </div>
      <text class="bar-title">{{ $t('settings.title') }}</text>
    </div>

    <scroll class="scroll" scroll-y="{{true}}">
      <div class="list">
        <div class="row" @click="openAccount">
          <text class="row-label">{{ $t('settings.account') }}</text>
          <text class="row-value">{{ accountLabel }}</text>
        </div>

        <div class="row" @click="openSetup">
          <text class="row-label">{{ $t('settings.fromPhone') }}</text>
          <text class="row-value">{{ $t('settings.fromPhoneHint') }}</text>
        </div>

        <div class="row" @click="cycleKeyboard">
          <text class="row-label">{{ $t('settings.keyboard') }}</text>
          <text class="row-value">{{ keyboardType }}</text>
        </div>

        <div class="row" @click="openAbout">
          <text class="row-label">{{ $t('settings.about') }}</text>
          <text class="row-value">{{ version }}</text>
        </div>

        <div class="row row-danger" @click="confirmClear">
          <text class="row-danger-text">{{ clearArmed ? $t('settings.clearAgain') : $t('settings.clear') }}</text>
        </div>
      </div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import prompt from '@system.prompt'
import store from '../../common/scripts/store'
import state from '../../common/scripts/state'
import api from '../../common/scripts/api'
import { ROUTE } from '../../common/scripts/launch'
import nav from '../../common/scripts/nav'
import manifest from '../../manifest.json'

export default {
  data: {
    version: manifest.versionName,
    accountLabel: '',
    keyboardType: 'QWERTY',
    clearArmed: false
  },

  onInit() {
    store.load().then((settings) => {
      state.settings = settings
      state.ready = store.hasAccount(settings)
      this.keyboardType = settings.keyboardType || 'QWERTY'
      this.refreshLabels(settings)
    })
  },

  onShow() {
    // nav.navigate() reads this to decide whether a push landed.
    this.leftPage = false
  },

  onHide() {
    this.leftPage = true
  },

  onDestroy() {
    // A replaced page is destroyed rather than hidden; nav.navigate() must count
    // that as "we left", or a working fallback would still raise the toast.
    this.leftPage = true
  },

  refreshLabels(settings) {
    const s = settings || {}
    if (store.hasAccount(s)) {
      this.accountLabel = s.user + '@' + String(s.baseUrl).replace(/^https?:\/\//, '')
    } else {
      this.accountLabel = this.$t('settings.notSet')
    }
  },

  persist(patch) {
    const save = () => {
      const merged = Object.assign({}, state.settings || {}, patch)
      return store.save(merged).then((saved) => {
        state.settings = saved
        // The API client reads the account from its own copy; keep it in sync so
        // changing settings never leaves a stale password behind.
        api.configure(saved)
        this.refreshLabels(saved)
        return saved
      })
    }
    this.persistQueue = (this.persistQueue || Promise.resolve()).then(save, save)
    return this.persistQueue
  },

  handlePersistFailure(err) {
    this.persistQueue = Promise.resolve()
    store.load().then((settings) => {
      state.settings = settings
      this.keyboardType = settings.keyboardType || 'QWERTY'
      this.refreshLabels(settings)
    })
    console.log('settings save failed: ' + ((err && err.message) || err))
    prompt.showToast({ message: this.$t('settings.saveFailed'), duration: 2000 })
  },

  cycleKeyboard() {
    const value = this.keyboardType === 'QWERTY' ? 'T9' : 'QWERTY'
    this.keyboardType = value
    this.persist({ keyboardType: value }).catch((err) => this.handlePersistFailure(err))
  },

  openAccount() {
    nav.navigate(this, ROUTE.login, null, this.$t('common.openFailed'))
  },

  openSetup() {
    nav.navigate(this, ROUTE.setup, null, this.$t('common.openFailed'))
  },

  openAbout() {
    prompt.showToast({
      message: 'Vela Nextcloud Talk ' + this.version,
      duration: 2000
    })
  },

  confirmClear() {
    if (!this.clearArmed) {
      this.clearArmed = true
      return
    }
    this.clearArmed = false
    store.clearAll().then(() => {
      state.settings = store.DEFAULT_SETTINGS
      state.ready = false
      state.rooms = []
      state.activeRoom = null
      api.configure({})
      prompt.showToast({ message: this.$t('settings.cleared'), duration: 1500 })
      // Back to the "no account" state, which starts at the setup page.
      router.replace({ uri: ROUTE.setup })
    }).catch((err) => {
      console.log('clear data failed: ' + ((err && err.message) || err))
      prompt.showToast({ message: this.$t('settings.clearFailed'), duration: 2000 })
    })
  },

  goBack() {
    // Installed by index's replace fallback rather than a push → back() is a
    // no-op, so fall through to the conversation list.
    nav.leave(ROUTE.home)
  }
}
</script>

<style>
@import "../../common/styles/theme.css";

/* Fixed pixel height, never `flex: 1`: a flex-resolved height makes this
 * firmware fit the content into the viewport instead of letting it overflow, so
 * the list cannot scroll and every row is compressed (see pages/chat and the
 * HyperBilibili global.less this theme came from).
 * 480 - 72 (bar) = 408; the RECT block overrides for the 640 screen. */
.scroll {
  width: 480px;
  height: 408px;
  flex-direction: column;
  align-items: center;
}

.list {
  /* Design pixels, not 100%: <scroll> content has no definite width, so a
   * percentage here collapsed every row inside it. */
  width: 480px;
  padding-top: 6px;
  padding-bottom: 12px;
  flex-direction: column;
  align-items: center;
}

/* One card per row, as in the template: the surface is the divider. */
.row {
  width: 394px;
  height: 84px;
  margin-top: 8px;
  border-radius: 26px;
  background-color: #262626;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.row-label {
  margin-left: 20px;
  font-size: 24px;
  font-weight: 600;
  color: #ffffff;
  lines: 1;
  text-overflow: ellipsis;
}

.row-value {
  width: 44%;
  margin-right: 20px;
  font-size: 20px;
  font-weight: 500;
  color: #ff7da8;
  text-align: right;
  lines: 1;
  text-overflow: ellipsis;
}

.row-danger {
  justify-content: center;
}

.row-danger-text {
  font-size: 22px;
  font-weight: 600;
  color: #ff8095;
  text-align: center;
}

/* if true: process.env.SHAPE === 'CIRCLE' */
.row {
  width: 374px;
  height: 78px;
}
/* endif */

/* if true: process.env.SHAPE === 'RECT' */
.app-bg {
  width: 480px;
  height: 640px;
}
.row {
  width: 413px;
  height: 80px;
  margin-top: 6px;
}
/* 640 - 72 (bar) */
.scroll {
  height: 568px;
}
/* endif */
</style>
