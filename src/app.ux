<script>
import store from './common/scripts/store'
import api from './common/scripts/api'
import fmt from './common/scripts/format'
import state from './common/scripts/state'
import keeperClient from './common/scripts/keeperClient'
import { FOREGROUND_LEASE_MS } from './common/scripts/keeper'

// The app renews the service's foreground lease from this heartbeat, so the
// lease (90s) outlives two missed beats. Cheap: a postMessage, no network.
const LEASE_HEARTBEAT_MS = FOREGROUND_LEASE_MS / 3

// The only truly cross-page object in the app. Pages reach it through
// `this.$app.$def.shared`; see common/scripts/shared.js for why module level
// state cannot do this job (each page bundle gets its own copy).
const shared = {
  // Advisory probe evidence (bilibili control + configured server). Read by
  // pages/index to turn a transport error into "the watch is online, this host
  // is not".
  controlProbe: null,
  serverProbe: null,
  // Last conversation list the keeper service saw while the app was away.
  backgroundSummary: null,
  // Message handed to pages/message when router params do not arrive (the
  // navigate ladder has a params-less rung). Cleared by the page on read.
  pendingDetail: null
}

export default {
  // Explicit key, not shorthand: pages reach it as $app.$def.shared.
  shared: shared,

  onCreate() {
    // `onShow` fires after this; assume visible until it says otherwise so a
    // slow settings read cannot start the background poller in the foreground.
    this.visible = true
    const translate = (key) => this.$t(key)
    api.setTranslator(translate)
    fmt.setTranslator(translate)

    // Start background retention *before* the settings read. It used to be
    // started from inside the `.then()` below, so a slow or failing storage read
    // (or a first launch with no account yet) left the service unconnected for
    // the whole session — the app kept working, background retention never did.
    // The service reads the account itself on every tick anyway.
    this.startKeeper()
    this.startHeartbeat()

    // Settings are read once at startup so every page gets a configured API
    // client without repeating storage reads. Pages still call store.load()
    // when they need the freshest values (e.g. right after editing the account).
    store.load()
      .then((settings) => {
        state.settings = settings
        state.ready = store.hasAccount(settings)
        api.configure(settings)
        console.log('app created, configured=' + state.ready)
      })
      .catch((err) => {
        console.log('app created, settings load failed: ' + (err && err.message))
      })
  },

  // The keeper micro service owns polling while the app is away; the pages own
  // it while the app is visible (they already fetch the same list and chat page
  // has its own message poll). See docs/design.md §11–12.
  //
  // Retention is not a setting: there is no account-, preference- or
  // toggle-shaped path that turns it off (design.md §12.6). Only the service
  // answering "no such service" keeps it off, and that is retried.
  startKeeper() {
    keeperClient.start({
      onSummary: (summary) => {
        // Pages/index reads this from `$app.$def.shared` (a module level
        // variable here would never reach another bundle).
        shared.backgroundSummary = summary
      }
    })
    // onShow may have fired before this call, in which case the service would
    // poll while the app is actually visible.
    keeperClient.foreground(this.visible !== false)
  },

  // Every beat keeps the service paused while the app is on screen. If the app
  // is killed without a word, the beats stop and the service resumes on its own
  // when the lease expires — the failure mode 1.0.14 could not escape.
  startHeartbeat() {
    if (this.heartbeatTimer) return
    this.heartbeatTimer = setInterval(() => {
      if (this.visible === false) return
      keeperClient.heartbeat()
    }, LEASE_HEARTBEAT_MS)
  },

  onShow() {
    this.visible = true
    keeperClient.foreground(true)
  },

  onHide() {
    this.visible = false
    keeperClient.foreground(false)
  },

  onDestroy() {
    if (this.heartbeatTimer) {
      clearInterval(this.heartbeatTimer)
      this.heartbeatTimer = null
    }
    console.log('app destroyed')
  }
}
</script>
