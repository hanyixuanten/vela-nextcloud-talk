{
  "package": "com.hanyixuanten.nctalk",
  "name": "Talk",
  "icon": "/common/images/icon.png",
  "versionName": "1.0.15",
  "versionCode": 31,
  "minPlatformVersion": 1000,
  "deviceTypeList": ["watch"],
  "features": [
    { "name": "system.router" },
    { "name": "system.fetch" },
    { "name": "system.storage" },
    { "name": "system.file" },
    { "name": "system.prompt" },
    { "name": "system.vibrator" },
    { "name": "system.device" },
    { "name": "system.interconnect" },
    { "name": "system.network" },
    { "name": "system.brightness" },
    { "name": "system.serviceclient" }
  ],
  "services": [
    {
      "name": "keeper",
      "path": "services/keeper",
      "autoStart": true,
      "permissions": []
    }
  ],
  "config": {
    "logLevel": "log",
    "designWidth": 480
  },
  "router": {
    "entry": "pages/splash",
    "pages": {
      "pages/splash": {
        "component": "splash"
      },
      "pages/index": {
        "component": "index"
      },
      "pages/login": {
        "component": "login"
      },
      "pages/chat": {
        "component": "chat"
      },
      "pages/message": {
        "component": "message"
      },
      "pages/settings": {
        "component": "settings"
      },
      "pages/setup": {
        "component": "setup"
      },
      "pages/offline": {
        "component": "offline"
      }
    }
  },
  "display": {
    "backgroundColor": "#000000"
  }
}
